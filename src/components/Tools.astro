---
/**
 * § III Tools: featured tools as pixel cards, then a short list of smaller
 * experiments. All copy lives in src/data/tools.ts.
 */
import SectionHead from "./SectionHead.astro";
import {
  featured,
  experiments,
  experimentsVisible,
  toolsIntro,
  toolsProfile,
  starsFetched,
  formatStars,
  type ToolVisual,
} from "../data/tools";

/** Split "a `b` c" into text and code segments. */
const segments = (s: string) =>
  s.split("`").map((text, i) => ({ text, code: i % 2 === 1 }));

const fetched = new Date(starsFetched).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});

/* ── Pixel sprites: 16x16 grids ──────────────────────────────
 * b = bone, a = ash, d = dust, e = ember, . = empty.
 * Horizontal runs of one color become one <rect>.            */
const SPRITES: Record<ToolVisual, string[]> = {
  // Memray: a flame graph, widest path at the bottom, the leaf in ember
  flame: [
    "................",
    ".ee.............",
    ".ee.............",
    "................",
    ".bbbb..aa.......",
    ".bbbb..aa.......",
    "................",
    ".bbbbbb.aaa.dd..",
    ".bbbbbb.aaa.dd..",
    "................",
    ".bbbbbbbbbb.aaa.",
    ".bbbbbbbbbb.aaa.",
    "................",
    ".bbbbbbbbbbbbbb.",
    ".bbbbbbbbbbbbbb.",
    "................",
  ],
  // PyStack: four frames, Python on top, native below, the leaf in ember
  stack: [
    "................",
    "................",
    ".bbbbbbbbbbbbbb.",
    ".bbbbbbbbbbbbbb.",
    "................",
    "..bbbbbbbbbbbbb.",
    "..bbbbbbbbbbbbb.",
    "................",
    "...aaaaaaaaaaaa.",
    "...aaaaaaaaaaaa.",
    "................",
    "....eeeeeeeeeee.",
    "....eeeeeeeeeee.",
    "................",
    "................",
    "................",
  ],
  // Tachyon: one stack sample per tick, one sample in ember
  sampling: [
    "................",
    "................",
    "................",
    ".............e..",
    ".....a.......e..",
    ".....a.a.....e..",
    "...a.a.a.....e..",
    "...a.a.a.a...e..",
    ".a.a.a.a.a.a.e..",
    ".a.a.a.a.a.a.e.a",
    ".a.a.a.a.a.a.e.a",
    ".a.a.a.a.a.a.e.a",
    "dddddddddddddddd",
    ".d.d.d.d.d.d.e.d",
    ".d.......d......",
    "................",
  ],
  // pytest-memray: a check mark over a bar that stays under the limit
  budget: [
    "................",
    "................",
    "............bb..",
    "...........bb...",
    "..........bb....",
    ".bb......bb.....",
    "..bb....bb......",
    "...bb..bb.......",
    "....bbbb........",
    ".....bb.........",
    "................",
    "............e...",
    ".aaaaaaaaa..e...",
    ".aaaaaaaaa..e...",
    "............e...",
    "................",
  ],
  // pegen: a small parse tree, the root in ember
  tree: [
    "................",
    "......eee.......",
    "......eee.......",
    ".......d........",
    "...ddddddddd....",
    "...d.......d....",
    "..bbb.....bbb...",
    "..bbb.....bbb...",
    "...d.......d....",
    ".ddddd.....d....",
    ".d...d.....d....",
    "aaa.aaa...aaa...",
    "aaa.aaa...aaa...",
    "................",
    "................",
    "................",
  ],
};

const FILL: Record<string, string> = {
  b: "var(--bone)",
  a: "var(--ash)",
  d: "var(--dust)",
  e: "var(--ember)",
};

const sprite = (v: ToolVisual) =>
  SPRITES[v].flatMap((row, y) => {
    const runs: { x: number; y: number; w: number; c: string }[] = [];
    let x = 0;
    while (x < row.length) {
      const c = row[x];
      let w = 1;
      while (row[x + w] === c) w++;
      if (c !== ".") runs.push({ x, y, w, c: FILL[c] });
      x += w;
    }
    return runs;
  });

const shown = experiments.slice(0, experimentsVisible);
const hidden = experiments.slice(experimentsVisible);
---

<section id="tools" class="tools">
  <div class="wrap">
    <SectionHead
      num={toolsIntro.num}
      title={toolsIntro.title}
      kicker={toolsIntro.kicker}
      lede={toolsIntro.lede}
    />

    <div class="cards">
      {
        featured.map((t) => (
          <article class={`card card--${t.id} reveal`} aria-labelledby={`tool-${t.id}`}>
            <div class="card__top">
              <svg
                  class="sprite"
                  viewBox="0 0 16 16"
                  width="80"
                  height="80"
                  shape-rendering="crispEdges"
                  aria-hidden="true"
                >
                  {sprite(t.visual).map((r) => (
                    <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.c} />
                  ))}
                </svg>
                <div class="card__meta">
                  {t.stars ? (
                    <span class="stars">
                      <span aria-hidden="true">★ </span>
                      {formatStars(t.stars)}
                      <span class="visually-hidden"> stars on GitHub</span>
                    </span>
                  ) : (
                    <span class="stars">{t.badge}</span>
                  )}
                  <span class="label">{t.language}</span>
                </div>
            </div>

            <div class="card__main">
              <h3 id={`tool-${t.id}`} class="display card__name">
                {t.name}
              </h3>
              <p class="label card__role">
                {t.alias && <span class="card__alias">{t.alias} · </span>}
                {t.role}
              </p>
              <p class="card__desc">{t.description}</p>
            </div>

            <div class="card__side">
              <pre class="term" tabindex="0" aria-label={`Example ${t.name} command`}><code><span class="term__ps" aria-hidden="true">$ </span>{t.command}</code></pre>

              <ul class="card__links">
                {t.links.map((l) => (
                  <li>
                    <a href={l.href}>
                      {l.label}
                      <span class="visually-hidden"> for {t.name}</span>
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="more reveal">
      <div class="more__head">
        <h3 class="display more__title">Other experiments</h3>
        <p class="label">Stars as of {fetched}</p>
      </div>

      <ul class="list">
        {
          shown.map((e) => (
            <li class="row">
              <a class="row__name" href={e.href}>
                {e.name}
              </a>
              <span class="row__stars">
                {e.stars > 0 && (
                  <>
                    <span aria-hidden="true">★ </span>
                    {formatStars(e.stars)}
                    <span class="visually-hidden"> stars</span>
                  </>
                )}
              </span>
              <p class="row__desc">
                {segments(e.description).map((s) => (s.code ? <code>{s.text}</code> : s.text))}
              </p>
              <span class="row__lang label">{e.language}</span>
            </li>
          ))
        }
      </ul>

      {
        hidden.length > 0 && (
          <details class="all">
            <summary class="all__toggle label">
              <span class="all__closed">Show all {experiments.length}</span>
              <span class="all__open">Show fewer</span>
            </summary>
            <ul class="list list--rest">
              {hidden.map((e) => (
                <li class="row">
                  <a class="row__name" href={e.href}>
                    {e.name}
                  </a>
                  <span class="row__stars">
                    {e.stars > 0 && (
                      <>
                        <span aria-hidden="true">★ </span>
                        {formatStars(e.stars)}
                        <span class="visually-hidden"> stars</span>
                      </>
                    )}
                  </span>
                  <p class="row__desc">
                    {segments(e.description).map((s) => (s.code ? <code>{s.text}</code> : s.text))}
                  </p>
                  <span class="row__lang label">{e.language}</span>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </div>

    <footer class="foot reveal">
      <a class="btn" href={toolsProfile.github}>github.com/{toolsProfile.handle} ↗</a>
    </footer>
  </div>
</section>

<style>
  .tools {
    padding-block: var(--space-8) var(--space-7);
  }

  /* ───────── cards ───────── */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-5);
    }
    .card--memray {
      grid-column: 1 / -1;
    }
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-5);
    min-width: 0;
    padding: var(--space-5);
    background: var(--ink);
    border: 2px solid var(--line-2);
  }
  .card:hover {
    border-color: var(--bone);
    box-shadow: 6px 6px 0 var(--ember-dim);
  }
  .card__main,
  .card__side {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
  }
  .card__side {
    gap: var(--space-4);
    align-content: end;
  }

  @media (min-width: 48rem) {
    .card--memray {
      grid-template-rows: auto auto;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-5) var(--space-6);
      align-items: end;
    }
    .card--memray .card__top {
      grid-column: 1 / -1;
    }
  }

  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .sprite {
    width: 80px;
    height: 80px;
    flex: none;
  }
  .card__meta {
    display: grid;
    justify-items: end;
    gap: var(--space-1);
    text-align: right;
  }
  .stars {
    font-family: var(--f-pixel);
    font-size: var(--step--1);
    text-transform: uppercase;
    color: var(--gold);
  }

  .card__name {
    font-size: var(--step-3);
    line-height: 0.95;
  }
  .card__alias {
    color: var(--ash);
    text-transform: none;
  }
  .card__desc {
    max-width: 38rem;
    color: var(--ash);
  }

  .term {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    background: var(--ink-2);
    border: 2px solid var(--line-2);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--bone);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .term code {
    font-size: inherit;
  }
  .term__ps {
    color: var(--ember);
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--f-pixel);
    font-size: var(--step--1);
    text-transform: uppercase;
  }
  .card__links a {
    text-decoration: none;
  }

  /* ───────── other experiments ───────── */
  .more {
    margin-top: var(--space-8);
  }
  .more__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
  }
  .more__title {
    font-size: var(--step-3);
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .list--rest {
    border-top: 0;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .row__name {
    font-family: var(--f-mono);
    color: var(--bone);
    overflow-wrap: anywhere;
  }
  .row__stars {
    font-family: var(--f-pixel);
    font-size: var(--step--1);
    color: var(--gold);
    text-align: right;
  }
  .row__desc {
    grid-column: 1 / -1;
    color: var(--ash);
    font-size: var(--step--1);
  }
  .row__desc code {
    font-size: 1em;
    color: var(--bone);
  }
  .row__lang {
    grid-column: 1 / -1;
  }
  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 13rem minmax(0, 1fr) 6rem 4rem;
      align-items: baseline;
    }
    .row__name {
      grid-column: 1;
      grid-row: 1;
    }
    .row__desc {
      grid-column: 2;
      grid-row: 1;
    }
    .row__lang {
      grid-column: 3;
      grid-row: 1;
    }
    .row__stars {
      grid-column: 4;
      grid-row: 1;
    }
  }

  .all__toggle {
    display: inline-block;
    margin-top: var(--space-5);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--line-2);
    color: var(--bone);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .all__toggle::-webkit-details-marker {
    display: none;
  }
  .all__toggle::before {
    content: "+ ";
    color: var(--ember);
  }
  .all__toggle:hover {
    border-color: var(--bone);
    box-shadow: 4px 4px 0 var(--ember-dim);
  }
  .all__open {
    display: none;
  }
  .all[open] .all__open {
    display: inline;
  }
  .all[open] .all__closed {
    display: none;
  }
  .all[open] > .all__toggle {
    margin-bottom: var(--space-5);
  }
  .all[open] > .all__toggle::before {
    content: "- ";
  }
  .all[open] .list--rest {
    border-top: 1px solid var(--line);
  }

  /* ───────── footer ───────── */
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }
  .bio {
    margin: 0;
    display: grid;
    gap: var(--space-1);
  }
  .bio p {
    color: var(--bone);
  }
</style>
