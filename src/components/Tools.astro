---
/**
 * § III Instruments: featured tools as engraved "plates", then an index of
 * smaller experiments. All copy lives in src/data/tools.ts.
 */
import SectionHead from "./SectionHead.astro";
import {
  featured,
  experiments,
  toolsIntro,
  toolsProfile,
  starsFetched,
  formatStars,
} from "../data/tools";

/** Split "a `b` c" into text and code segments. */
const segments = (s: string) =>
  s.split("`").map((text, i) => ({ text, code: i % 2 === 1 }));

const fetched = new Date(starsFetched).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});

/* ── Fig: Memray flame graph ─────────────────────────────── */
const FW = 520;
const rowH = 21;
const flameBase = 128;
const flameFrames: [number, number, number, string, boolean][] = [
  [0, 0, 1, "main", true],
  [1, 0, 0.72, "run", true],
  [1, 0.72, 0.28, "serve", false],
  [2, 0, 0.47, "load_dataset", true],
  [2, 0.47, 0.25, "build_index", false],
  [2, 0.72, 0.2, "handle", false],
  [3, 0, 0.31, "read_csv", true],
  [3, 0.31, 0.16, "decode", false],
  [3, 0.47, 0.14, "dict.update", false],
  [3, 0.72, 0.12, "json.loads", false],
  [4, 0, 0.23, "_parse", true],
  [4, 0.31, 0.08, "", false],
  [4, 0.72, 0.06, "", false],
  [5, 0, 0.15, "malloc", true],
];
const flame = flameFrames.map(([d, x0, w, label, hot]) => {
  const x = 1 + x0 * (FW - 2);
  const width = w * (FW - 2) - 3;
  const y = flameBase - (d + 1) * rowH;
  return {
    x,
    y,
    width,
    // sized for the larger mobile label font (14px, ~8.4 user units per char)
    label: width > label.length * 8.4 + 10 ? label : "",
    hot,
    leaf: hot && d === 5,
  };
});

/* ── Fig: Tachyon sampling timeline ──────────────────────── */
const N = 48;
const hiCol = 31;
const sampleX = (i: number) => 12 + i * 10.5;
const depth = (i: number) =>
  Math.max(2, Math.min(9, Math.round(4.6 + 2 * Math.sin(i * 0.33) + 1.3 * Math.sin(i * 0.9 + 1))));
const samples = Array.from({ length: N }, (_, i) => ({
  x: sampleX(i),
  d: depth(i),
  hi: i === hiCol,
}));

/* ── Fig: PyStack frames ─────────────────────────────────── */
const stackRows = [
  { kind: "Python", fn: "<module>", loc: "app.py:12" },
  { kind: "Python", fn: "main", loc: "app.py:8" },
  { kind: "Python", fn: "serve", loc: "server.py:31" },
  { kind: "C", fn: "sock_accept", loc: "socketmodule.c" },
  { kind: "C", fn: "accept", loc: "libc.so.6" },
].map((r, i) => ({ ...r, x: 14 + i * 16, y: 34 + i * 31, leaf: i === 4 }));

/* ── Fig: pytest-memray budget ───────────────────────────── */
const mb = (v: number) => 118 + v * 6.5;
const budgetRows = [
  { name: "test_parse", v: 9 },
  { name: "test_cache", v: 31 },
  { name: "test_export", v: 16 },
].map((r, i) => ({ ...r, y: 40 + i * 30, over: r.v > 24 }));

/* ── Fig: pegen parse tree ───────────────────────────────── */
const treeNodes = [
  { id: "a", label: "expr", x: 230, y: 20, nt: true },
  { id: "b", label: "expr", x: 110, y: 66, nt: true },
  { id: "c", label: "'+'", x: 230, y: 66, nt: false },
  { id: "d", label: "term", x: 350, y: 66, nt: true },
  { id: "e", label: "term", x: 110, y: 112, nt: true },
  { id: "f", label: "2", x: 350, y: 112, nt: false },
  { id: "g", label: "1", x: 110, y: 158, nt: false },
];
const node = (id: string) => treeNodes.find((n) => n.id === id)!;
const treeEdges = [
  ["a", "b", true],
  ["a", "c", false],
  ["a", "d", false],
  ["b", "e", false],
  ["d", "f", false],
  ["e", "g", false],
].map(([from, to, rec]) => ({ a: node(from as string), b: node(to as string), rec }));
---

<section id="tools" class="tools">
  <div class="wrap">
    <SectionHead
      num={toolsIntro.num}
      title={toolsIntro.title}
      kicker={toolsIntro.kicker}
      lede={toolsIntro.lede}
    />

    <div class="plates">
      {
        featured.map((t, i) => (
          <article class={`plate plate--${t.id} reveal`} aria-labelledby={`tool-${t.id}`}>
            <header class="plate__top">
              <span class="plate__no mono">Pl. {t.plate}</span>
              <span class="plate__lang label">{t.language}</span>
              {t.stars ? (
                <span class="stars mono">
                  <span aria-hidden="true">★ </span>
                  {formatStars(t.stars)}
                  <span class="visually-hidden"> stars on GitHub</span>
                </span>
              ) : (
                <span class="badge mono">{t.badge}</span>
              )}
            </header>

            <div class="plate__head">
              <h3 id={`tool-${t.id}`} class="display plate__name">
                {t.name}
              </h3>
              {t.alias && <p class="plate__alias mono">{t.alias}</p>}
              <p class="plate__tagline">{t.tagline}</p>
              <p class="plate__role label">{t.role}</p>
            </div>

            <figure class="plate__fig fig">
              <div class="fig__art" aria-hidden="true">
                {t.visual === "flame" && (
                  <svg viewBox={`0 0 ${FW} 160`} class="svg">
                    <defs>
                      <pattern id="tl-hatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <line x1="0" y1="0" x2="0" y2="4" class="hatch" />
                      </pattern>
                      <pattern id="tl-hatch-hot" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <line x1="0" y1="0" x2="0" y2="3" class="hatch hatch--hot" />
                      </pattern>
                    </defs>
                    {flame.map((f) => (
                      <g>
                        <rect
                          x={f.x}
                          y={f.y}
                          width={f.width}
                          height={rowH - 3}
                          class={f.leaf ? "fl fl--leaf" : f.hot ? "fl fl--hot" : "fl"}
                        />
                        {f.label && (
                          <text x={f.x + 6} y={f.y + 13.5} class={f.leaf ? "t t--ink" : "t"}>
                            {f.label}
                          </text>
                        )}
                      </g>
                    ))}
                    <line x1="1" x2={FW - 1} y1="134" y2="134" class="axis" />
                    {[0, 0.25, 0.5, 0.75, 1].map((p) => (
                      <line x1={1 + p * (FW - 2)} x2={1 + p * (FW - 2)} y1="134" y2="139" class="axis" />
                    ))}
                    <text x="1" y="156" class="t t--dust">0 B</text>
                    <text x={FW - 1} y="156" class="t t--dust" text-anchor="end">
                      bytes allocated
                    </text>
                  </svg>
                )}

                {t.visual === "sampling" && (
                  <svg viewBox="0 0 520 150" class="svg">
                    {samples.map((s) => (
                      <g class={s.hi ? "col col--hi" : "col"}>
                        {Array.from({ length: s.d }, (_, k) => (
                          <rect
                            x={s.x}
                            y={112 - (k + 1) * 9}
                            width="6.5"
                            height="7"
                            class={k === s.d - 1 ? "cell cell--leaf" : "cell"}
                          />
                        ))}
                      </g>
                    ))}
                    <line x1="6" x2="514" y1="118" y2="118" class="axis" />
                    {samples.map((s, i) => (
                      <line
                        x1={s.x + 3.25}
                        x2={s.x + 3.25}
                        y1="118"
                        y2={i % 12 === 0 ? 127 : 122}
                        class={s.hi ? "tick tick--hi" : "tick"}
                      />
                    ))}
                    {[0, 12, 24, 36].map((i) => (
                      <text x={sampleX(i) + 1} y="140" class="t t--dust">
                        {i} ms
                      </text>
                    ))}
                    <text x={sampleX(hiCol) + 3.25} y="140" class="t t--ember" text-anchor="middle">
                      ^
                    </text>
                    <rect x="0" y="16" width="1" height="102" class="scan" />
                  </svg>
                )}

                {t.visual === "stack" && (
                  <svg viewBox="0 0 440 190" class="svg">
                    <text x="0" y="16" class="t t--sm">
                      Traceback for thread 4242 (python3)
                      <tspan class="t--ember">[Has the GIL]</tspan>
                    </text>
                    {stackRows.map((r, i) => (
                      <g>
                        {i > 0 && (
                          <path
                            d={`M${stackRows[i - 1].x + 8} ${stackRows[i - 1].y + 22} V${r.y + 11} H${r.x}`}
                            class="axis"
                          />
                        )}
                        <rect x={r.x} y={r.y} width={436 - r.x} height="22" class={r.leaf ? "frame frame--leaf" : "frame"} />
                        <text x={r.x + 10} y={r.y + 15} class="t">
                          <tspan class={r.kind === "C" ? "t--dust" : "t--ash"}>({r.kind})</tspan>
                          <tspan dx="6">{r.fn}</tspan>
                        </text>
                        <text x="426" y={r.y + 15} class="t t--dust" text-anchor="end">
                          {r.loc}
                        </text>
                      </g>
                    ))}
                  </svg>
                )}

                {t.visual === "budget" && (
                  <svg viewBox="0 0 440 150" class="svg">
                    <defs>
                      <pattern id="tl-hatch-b" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <line x1="0" y1="0" x2="0" y2="4" class="hatch" />
                      </pattern>
                    </defs>
                    <text x={mb(24)} y="14" class="t t--ember" text-anchor="middle">
                      limit 24 MB
                    </text>
                    {budgetRows.map((r) => (
                      <g>
                        <text x="0" y={r.y + 12} class="t">
                          {r.name}
                        </text>
                        <rect
                          x={mb(0)}
                          y={r.y}
                          width={mb(r.v) - mb(0)}
                          height="16"
                          class={r.over ? "bar bar--over" : "bar"}
                        />
                        <text x={mb(r.v) + 7} y={r.y + 12} class={r.over ? "t t--ember" : "t t--dust"}>
                          {r.v} MB{r.over ? " ✗" : ""}
                        </text>
                      </g>
                    ))}
                    <line x1={mb(0)} x2={mb(40)} y1="128" y2="128" class="axis" />
                    {[0, 10, 20, 30, 40].map((v) => (
                      <g>
                        <line x1={mb(v)} x2={mb(v)} y1="128" y2="132" class="axis" />
                        <text x={mb(v)} y="145" class="t t--dust" text-anchor="middle">
                          {v}
                        </text>
                      </g>
                    ))}
                    <line x1={mb(24)} x2={mb(24)} y1="22" y2="128" class="limit" />
                  </svg>
                )}

                {t.visual === "tree" && (
                  <svg viewBox="0 0 460 172" class="svg svg--tree">
                    {treeEdges.map((e) => (
                      <line
                        x1={e.a.x}
                        y1={e.a.y + 11}
                        x2={e.b.x}
                        y2={e.b.y - 11}
                        class={e.rec ? "edge edge--rec" : "edge"}
                      />
                    ))}
                    {treeNodes.map((n) => (
                      <g>
                        {n.nt && (
                          <rect
                            x={n.x - (n.label.length * 7.2 + 20) / 2}
                            y={n.y - 11}
                            width={n.label.length * 7.2 + 20}
                            height="22"
                            class="frame"
                          />
                        )}
                        <text x={n.x} y={n.y + 4} class={n.nt ? "t t--lg" : "t t--lg t--ash"} text-anchor="middle">
                          {n.label}
                        </text>
                      </g>
                    ))}
                    <text x="0" y="112" class="t t--ember">left</text>
                    <text x="0" y="126" class="t t--ember">recursion</text>
                  </svg>
                )}
              </div>
              <figcaption>
                <span class="label">Fig. {i + 1}.</span> {t.caption}
              </figcaption>
            </figure>

            <p class="plate__desc">{t.description}</p>

            <ul class="plate__feat">
              {t.features.map((f) => (
                <li>{segments(f).map((s) => (s.code ? <code>{s.text}</code> : s.text))}</li>
              ))}
            </ul>

            <div class="plate__term term">
              <div class="term__bar" aria-hidden="true">
                <span>sh</span>
                <span>{t.id}</span>
              </div>
              <pre tabindex="0" aria-label={`Example ${t.name} commands`}><code>{t.commands.map((c) => (
                <span class="term__line"><span class="term__ps" aria-hidden="true">$ </span>{c}</span>
              ))}</code></pre>
            </div>

            <ul class="plate__links">
              {t.links.map((l) => (
                <li>
                  <a href={l.href}>
                    {l.label}
                    <span class="visually-hidden"> for {t.name}</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="index reveal">
      <div class="index__head">
        <h3 class="display index__title">Other experiments</h3>
        <p class="label">
          Smaller spells, mostly native · <span class="gold">★</span> as of {fetched}
        </p>
      </div>
      <ol class="index__list">
        {
          experiments.map((e, i) => (
            <li class="row">
              <span class="row__n mono" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <a class="row__name mono" href={e.href}>
                {e.name}
              </a>
              <p class="row__desc">
                {segments(e.description).map((s) => (s.code ? <code>{s.text}</code> : s.text))}
              </p>
              <span class="row__lang label">{e.language}</span>
              <span class="row__stars mono">
                {e.stars > 0 && (
                  <>
                    <span aria-hidden="true">★ </span>
                    {formatStars(e.stars)}
                    <span class="visually-hidden"> stars</span>
                  </>
                )}
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <footer class="tools__foot reveal">
      <blockquote class="bio">
        <p><span class="ember">“</span>{toolsProfile.bio}<span class="ember">”</span></p>
        <cite class="label">From my GitHub bio</cite>
      </blockquote>
      <a class="btn" href={toolsProfile.github}>
        <span><span class="ember" aria-hidden="true">&gt;&gt;&gt; </span>github.com/{toolsProfile.handle}</span>
      </a>
    </footer>
  </div>
</section>

<style>
  .tools {
    padding-block: var(--space-8) var(--space-7);
  }

  /* ───────── plates grid ───────── */
  .plates {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }

  .plate {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "top"
      "head"
      "fig"
      "desc"
      "feat"
      "term"
      "links";
    align-content: start;
    gap: var(--space-5);
    min-width: 0;
    padding-block: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .plate__top {
    grid-area: top;
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }
  .plate__no {
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .plate__lang {
    margin-right: auto;
  }
  .stars,
  .gold {
    color: var(--gold);
  }
  .stars {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .badge {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    padding: 0.15em 0.5em;
    white-space: nowrap;
  }

  .plate__head {
    grid-area: head;
    display: grid;
    gap: var(--space-2);
  }
  .plate__name {
    font-size: var(--step-4);
    line-height: 0.9;
    overflow-wrap: break-word;
  }
  .plate__alias {
    font-size: var(--step--1);
    color: var(--ash);
  }
  .plate__tagline {
    font-style: italic;
    font-size: var(--step-1);
    color: var(--bone);
    line-height: 1.3;
  }
  .plate__role {
    color: var(--dust);
  }

  .plate__fig {
    grid-area: fig;
  }
  .plate__desc {
    grid-area: desc;
    color: var(--ash);
    max-width: 40rem;
  }
  .plate__feat {
    grid-area: feat;
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .plate__feat li {
    position: relative;
    padding-left: 1.4em;
  }
  .plate__feat li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.8em;
    height: 1px;
    background: var(--dust);
  }
  .plate__feat code,
  .row__desc code {
    font-size: 0.86em;
    color: var(--bone);
    overflow-wrap: anywhere;
  }
  .plate__feat li {
    color: var(--ash);
    font-family: var(--f-mono);
    font-size: 0.82em;
  }

  .plate__term {
    grid-area: term;
  }
  .plate__links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plate__links a {
    font-family: var(--f-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone);
    border-bottom: 1px solid var(--line-2);
    padding-bottom: 0.25em;
  }
  .plate__links a:hover {
    color: var(--ember);
    border-color: var(--ember);
  }

  /* ───────── figures ───────── */
  .fig {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .fig__art {
    padding: var(--space-3);
    border: 1px solid var(--line);
    background:
      linear-gradient(var(--line), var(--line)) top left / 7px 1px no-repeat,
      var(--ink);
  }
  .fig figcaption {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--dust);
    line-height: 1.4;
  }
  .fig figcaption .label {
    font-style: normal;
    margin-right: 0.3em;
  }

  .svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* SVG user units: the figures shrink on phones, so the type grows there */
  .svg--tree {
    max-width: 30rem;
    margin-inline: auto;
  }
  .t {
    font-family: var(--f-mono);
    font-size: 14px;
    fill: var(--bone);
  }
  .t--sm {
    font-size: 13px;
    fill: var(--ash);
  }
  .t--lg {
    font-size: 15px;
  }
  @media (min-width: 48rem) {
    .fig__art {
      padding: var(--space-4);
    }
    .t {
      font-size: 11px;
    }
    .t--sm {
      font-size: 10.5px;
    }
    .t--lg {
      font-size: 12.5px;
    }
  }
  .t--ink {
    fill: var(--ink);
  }
  .t--dust {
    fill: var(--dust);
  }
  .t--ash {
    fill: var(--ash);
  }
  .t--ember {
    fill: var(--ember);
  }
  .hatch {
    stroke: var(--line-2);
    stroke-width: 1.2;
  }
  .hatch--hot {
    stroke: var(--ember-dim);
  }
  .axis {
    stroke: var(--line-2);
    stroke-width: 1;
    fill: none;
  }

  /* memray */
  .fl {
    fill: url(#tl-hatch);
    stroke: var(--line-2);
    stroke-width: 1;
  }
  .fl--hot {
    fill: url(#tl-hatch-hot);
    stroke: var(--ember-dim);
  }
  .fl--leaf {
    fill: var(--ember);
    stroke: var(--ember);
  }

  /* tachyon */
  .cell {
    fill: none;
    stroke: var(--dust);
    stroke-width: 1;
  }
  .cell--leaf {
    fill: var(--ash);
    stroke: var(--ash);
  }
  .col--hi .cell {
    stroke: var(--ember);
  }
  .col--hi .cell--leaf {
    fill: var(--ember);
  }
  .tick {
    stroke: var(--dust);
    stroke-width: 1;
  }
  .tick--hi {
    stroke: var(--ember);
  }
  .scan {
    fill: var(--ember);
    opacity: 0.45;
    animation: tl-scan 14s linear infinite;
  }
  @keyframes tl-scan {
    from {
      transform: translateX(6px);
    }
    to {
      transform: translateX(514px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scan {
      display: none;
    }
  }

  /* pystack + pegen */
  .frame {
    fill: var(--ink-2);
    stroke: var(--line-2);
    stroke-width: 1;
  }
  .frame--leaf {
    stroke: var(--ember);
  }
  .edge {
    stroke: var(--line-2);
    stroke-width: 1;
  }
  .edge--rec {
    stroke: var(--ember);
  }

  /* pytest-memray */
  .bar {
    fill: url(#tl-hatch-b);
    stroke: var(--ash);
    stroke-width: 1;
  }
  .bar--over {
    fill: var(--ember-dim);
    stroke: var(--ember);
  }
  .limit {
    stroke: var(--ember);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  /* ───────── terminal ───────── */
  .term {
    min-width: 0;
    border: 1px solid var(--line);
    background: var(--ink-2);
  }
  .term__bar {
    display: flex;
    justify-content: space-between;
    padding: 0.4em 0.9em;
    border-bottom: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dust);
