---
/**
 * Hero: the title page. A real-time lensed Schwarzschild black hole in
 * dithered pixel art (src/scripts/blackhole.ts) behind the name, one REPL
 * exchange and two links. A small readout shows the live render values;
 * on hover it traces the ray under the pointer (src/scripts/geodesic.ts).
 * All copy lives in HERO below.
 */
const HERO = {
  first: "Pablo",
  last: "Galindo Salgado",
  replInput: "pablo.occupation",
  replOutputs: [
    "works on the CPython parser and error messages",
    "writes profilers and debuggers for Python",
    "co-hosts the core.py podcast",
  ],
  primary: { label: "About me", href: "#about" },
  secondary: { label: "Listen to core.py", href: "#corepy" },
  hoverHint: "Point at the image to trace one ray. Click to launch rays from that point.",
  touchHint: "Tap the image to launch rays from that point.",
};

const repr = (s: string) => `'${s}'`;
---

<section id="hero" class="hero" aria-labelledby="hero-name">
  <div class="art" aria-hidden="true">
    <canvas class="gl" data-bh-canvas></canvas>
    <canvas class="gl" data-bh-over></canvas>
    <div class="anchor" data-bh-anchor>
      <svg class="still" viewBox="-100 -100 200 200" focusable="false" shape-rendering="crispEdges">
        <g transform="rotate(-7)">
          <circle r="70" class="still__ring"></circle>
          <ellipse rx="92" ry="11" class="still__disk"></ellipse>
          <ellipse rx="58" ry="6.6" class="still__disk"></ellipse>
          <path d="M -34 -2 A 34 30 0 0 1 34 -2" class="still__disk"></path>
          <circle r="19.5" class="still__hole"></circle>
          <path d="M -44 1.6 A 44 5 0 0 0 44 1.6" class="still__hot"></path>
        </g>
      </svg>
    </div>
  </div>

  <div class="wrap content">
    <h1 id="hero-name" class="name display">
      <span class="name__first">{HERO.first}</span>
      <span class="name__last">{HERO.last}</span>
    </h1>

    <div class="repl" aria-hidden="true" data-repl data-outputs={JSON.stringify(HERO.replOutputs.map(repr))}>
      <p class="repl__in">
        <span class="repl__ps">&gt;&gt;&gt;</span>
        <span data-repl-in>{HERO.replInput}</span><span class="repl__cursor" data-repl-cursor></span>
      </p>
      <p class="repl__out">
        {HERO.replOutputs.map((o) => <span class="repl__ghost">{repr(o)}</span>)}
        <span class="repl__line"><span class="repl__live" data-repl-out>{repr(HERO.replOutputs[0])}</span></span>
      </p>
    </div>
    <p class="visually-hidden">
      {HERO.replInput}: {HERO.replOutputs.join("; ")}.
    </p>

    <div class="actions">
      <a class="btn btn--solid" href={HERO.primary.href}>
        {HERO.primary.label} <span aria-hidden="true">↓</span>
      </a>
      <a class="btn" href={HERO.secondary.href}>{HERO.secondary.label}</a>
    </div>
  </div>

  <div class="readout" data-readout>
    <p class="readout__live" data-live>SCHWARZSCHILD · i --.-° · φ ---.-° · ------ RAYS/FRAME · -- FPS</p>
    <p class="readout__ray" data-ray data-hint-touch={HERO.touchHint}>{HERO.hoverHint}</p>
  </div>
</section>

<script>
  import { mountBlackHole, type ViewFrame } from "../scripts/blackhole";
  import { cameraBasis, projectUv, traceRay, DISK, CAPTURED, CAM_DIST, FOV, type V3 } from "../scripts/geodesic";

  const hero = document.getElementById("hero");
  const canvas = hero?.querySelector<HTMLCanvasElement>("[data-bh-canvas]");
  const overlay = hero?.querySelector<HTMLCanvasElement>("[data-bh-over]");
  const anchor = hero?.querySelector<HTMLElement>("[data-bh-anchor]");
  const live = hero?.querySelector<HTMLElement>("[data-live]");
  const rayOut = hero?.querySelector<HTMLElement>("[data-ray]");

  // ---- live readout: the real values of the frame on screen ----
  const deg = (r: number) => (r * 180) / Math.PI;
  const wrap360 = (d: number) => ((d % 360) + 360) % 360;
  let view: ViewFrame | null = null;
  let fpsAcc = 0;
  let fpsN = 0;
  let lastText = 0;

  const onFrame = (f: ViewFrame) => {
    view = f;
    if (f.dt > 0) {
      fpsAcc += f.dt;
      fpsN++;
    }
    const now = performance.now();
    if (live && now - lastText > 250) {
      lastText = now;
      const fps = fpsAcc > 0 ? Math.round(fpsN / fpsAcc) : 0;
      fpsAcc = 0;
      fpsN = 0;
      const incl = 90 - deg(f.el);
      live.textContent =
        `SCHWARZSCHILD · i ${incl.toFixed(1).padStart(4, "\u2007")}° · ` +
        `φ ${wrap360(deg(f.az)).toFixed(1).padStart(5, "\u2007")}° · ` +
        `${(f.width * f.height).toLocaleString("en-US")} RAYS/FRAME · ` +
        `${f.still ? "STILL" : `${String(fps).padStart(2, "\u2007")} FPS`}`;
    }
    if (pointer) inspect();
    drawOverlay(f.dt);
  };

  // ---- hover inspector: trace the ray under the pointer in JS ----
  let pointer: { x: number; y: number } | null = null;
  let lastTrace = 0;
  const octx = overlay?.getContext("2d") ?? null;

  function redshift(hit: V3, prev: V3): number {
    // the shader's Doppler x gravitational factor at the hit
    const r = Math.hypot(hit[0], hit[2]);
    const vd = [hit[2] / r, 0, -hit[0] / r];
    const d = [hit[0] - prev[0], hit[1] - prev[1], hit[2] - prev[2]];
    const dl = Math.hypot(d[0], d[1], d[2]) || 1;
    const beta = Math.sqrt(0.5 / Math.max(r - 1, 0.6));
    const gamma = 1 / Math.sqrt(1 - beta * beta);
    const cosT = -(vd[0] * d[0] + vd[2] * d[2]) / dl;
    const D = 1 / (gamma * (1 - beta * cosT));
    return D * Math.sqrt(1 - 1 / r);
  }

  function inspect() {
    if (!view || !pointer || !rayOut || !hero) return;
    const now = performance.now();
    if (now - lastTrace < 50) return;
    lastTrace = now;
    const hr = hero.getBoundingClientRect();
    const k = view.scale;
    const px = Math.floor((pointer.x - hr.left) / k) + 0.5;
    const py = Math.floor(view.height - (pointer.y - hr.top) / k) + 0.5;
    const u = (px - view.center[0]) / view.radius;
    const v = (py - view.center[1]) / view.radius;
    const c = cameraBasis(view.el, view.az);
    const ray = traceRay(c, u, v);
    const rd = [ray.path[3] - ray.path[0], ray.path[4] - ray.path[1], ray.path[5] - ray.path[2]];
    const rl = Math.hypot(rd[0], rd[1], rd[2]) || 1;
    const ro = c.ro;
    // impact parameter b = |ro × rd|
    const cx = ro[1] * rd[2] - ro[2] * rd[1];
    const cy = ro[2] * rd[0] - ro[0] * rd[2];
    const cz = ro[0] * rd[1] - ro[1] * rd[0];
    const b = Math.hypot(cx, cy, cz) / rl;
    let tail: string;
    if (ray.fate === DISK && ray.hit) {
      const i = Math.max(0, ray.hitIndex - 1) * 3;
      const prev: V3 = [ray.path[i], ray.path[i + 1], ray.path[i + 2]];
      tail = `DISK r ${Math.hypot(ray.hit[0], ray.hit[2]).toFixed(2)} · g ${redshift(ray.hit, prev).toFixed(2)}`;
    } else if (ray.fate === CAPTURED) {
      tail = "CAPTURED · crossed r = 1";
    } else {
      const sd = ray.sky ?? [rd[0] / rl, rd[1] / rl, rd[2] / rl];
      const cos = (sd[0] * rd[0] + sd[1] * rd[1] + sd[2] * rd[2]) / rl;
      tail = `SKY · bent ${deg(Math.acos(Math.max(-1, Math.min(1, cos)))).toFixed(1)}°`;
    }
    if (!shotText || now > shotText) rayOut.textContent = `RAY b ${b.toFixed(2)} · r min ${ray.minR.toFixed(2)} · ${tail}`;
    marker = [Math.floor(px), Math.floor(view.height - py)];
  }

  // ---- click: launch a fan of photons from the clicked point ----
  // Forward integration of null geodesics with the render's equation,
  // d²x/dλ² = -3/2 · h² · x / r⁵. The photons fly through the disk (it is
  // the emitter). Paths are projected with the live camera every frame.
  interface Shot {
    pts: number[]; // x, y, z per point
    head: number; // float index of the photon along pts
    captured: boolean;
    born: number;
  }
  const shots: Shot[] = [];
  let marker: [number, number] | null = null;
  let shotText = 0;
  const SHADOW_UV = (Math.sqrt(27) / 2 / CAM_DIST / FOV) * 1.04; // apparent shadow radius

  function integrate(p0: V3, d0: V3): { pts: number[]; captured: boolean } {
    let pos: V3 = [...p0];
    let vel: V3 = [...d0];
    const hx = pos[1] * vel[2] - pos[2] * vel[1];
    const hy = pos[2] * vel[0] - pos[0] * vel[2];
    const hz = pos[0] * vel[1] - pos[1] * vel[0];
    const h2 = hx * hx + hy * hy + hz * hz;
    const pts = [...pos];
    const accel = (q: V3): V3 => {
      const r = Math.hypot(q[0], q[1], q[2]);
      const k = (-1.5 * h2) / r ** 5;
      return [k * q[0], k * q[1], k * q[2]];
    };
    let acc = accel(pos);
    for (let i = 0; i < 900; i++) {
      const r = Math.hypot(pos[0], pos[1], pos[2]);
      if (r < 1) return { pts, captured: true };
      if (r > 70) break;
      const hs = 0.05 * r;
      const vh: V3 = [vel[0] + acc[0] * 0.5 * hs, vel[1] + acc[1] * 0.5 * hs, vel[2] + acc[2] * 0.5 * hs];
      pos = [pos[0] + vh[0] * hs, pos[1] + vh[1] * hs, pos[2] + vh[2] * hs];
      acc = accel(pos);
      vel = [vh[0] + acc[0] * 0.5 * hs, vh[1] + acc[1] * 0.5 * hs, vh[2] + acc[2] * 0.5 * hs];
      pts.push(pos[0], pos[1], pos[2]);
    }
    // far away the path is a straight line: carry it off screen
    const vl = Math.hypot(vel[0], vel[1], vel[2]);
    for (let i = 1; i <= 40; i++) {
      const s = i * 8;
      pts.push(pos[0] + (vel[0] / vl) * s, pos[1] + (vel[1] / vl) * s, pos[2] + (vel[2] / vl) * s);
    }
    return { pts, captured: false };
  }

  function launch(clientX: number, clientY: number) {
    if (!view || !hero) return;
    const hr = hero.getBoundingClientRect();
    const k = view.scale;
    const px = Math.floor((clientX - hr.left) / k) + 0.5;
    const py = Math.floor(view.height - (clientY - hr.top) / k) + 0.5;
    const c = cameraBasis(view.el, view.az);
    const ray = traceRay(c, (px - view.center[0]) / view.radius, (py - view.center[1]) / view.radius);
    // emission point: the disk point seen there, else the ray's closest approach
    let p: V3;
    if (ray.fate === DISK && ray.hit) {
      p = [...ray.hit];
    } else {
      let best = 0;
      let bestR = Infinity;
      for (let i = 0; i < ray.path.length; i += 3) {
        const r = Math.hypot(ray.path[i], ray.path[i + 1], ray.path[i + 2]);
        if (r < bestR) {
          bestR = r;
          best = i;
        }
      }
      p = [ray.path[best], ray.path[best + 1], ray.path[best + 2]];
      const r = Math.hypot(...p);
      const target = Math.min(Math.max(r, 2.2), 7); // keep the launch close to the hole
      p = [(p[0] / r) * target, (p[1] / r) * target, (p[2] / r) * target];
    }
    const r0 = Math.hypot(...p);
    const er: V3 = [p[0] / r0, p[1] / r0, p[2] / r0];
    // tangent frame: t1 along the disk's rotation, t2 completes it
    let t1: V3 = [er[2], 0, -er[0]];
    const tl = Math.hypot(...t1) || 1;
    t1 = [t1[0] / tl, t1[1] / tl, t1[2] / tl];
    const t2: V3 = [er[1] * t1[2] - er[2] * t1[1], er[2] * t1[0] - er[0] * t1[2], er[0] * t1[1] - er[1] * t1[0]];
    const psi0 = Math.random() * Math.PI * 2;
    let esc = 0;
    let cap = 0;
    for (const [lift, dpsi] of [[-0.45, 0], [-0.15, 0.5], [0.1, -0.4], [0.35, 0.9], [0.7, -1.1]]) {
      const psi = psi0 + dpsi;
      const tx = Math.cos(psi) * Math.cos(lift);
      const ty = Math.sin(psi) * Math.cos(lift);
      const d: V3 = [
        er[0] * Math.sin(lift) + t1[0] * tx + t2[0] * ty,
        er[1] * Math.sin(lift) + t1[1] * tx + t2[1] * ty,
        er[2] * Math.sin(lift) + t1[2] * tx + t2[2] * ty,
      ];
      const { pts, captured } = integrate(p, d);
      captured ? cap++ : esc++;
      shots.push({ pts, head: 0, captured, born: performance.now() });
    }
    while (shots.length > 20) shots.shift();
    if (rayOut) {
      rayOut.textContent = `LAUNCHED 5 RAYS FROM r ${r0.toFixed(2)} · ${esc} ESCAPED · ${cap} CAPTURED`;
      shotText = performance.now() + 4000;
    }
  }

  // project a world point to overlay pixels; null if hidden behind the hole
  function toPx(c: ReturnType<typeof cameraBasis>, q: number[], i: number): [number, number] | null {
    if (!view) return null;
    const p: V3 = [q[i], q[i + 1], q[i + 2]];
    const uv = projectUv(c, p);
    if (!uv) return null;
    const behind = (p[0] - c.ro[0]) * c.fw[0] + (p[1] - c.ro[1]) * c.fw[1] + (p[2] - c.ro[2]) * c.fw[2] > CAM_DIST;
    if (behind && Math.hypot(uv[0], uv[1]) < SHADOW_UV) return null;
    return [Math.floor(view.center[0] + uv[0] * view.radius), Math.floor(view.height - (view.center[1] + uv[1] * view.radius))];
  }

  function line(ctx: CanvasRenderingContext2D, a: [number, number], b: [number, number]) {
    let [x0, y0] = a;
    const [x1, y1] = b;
    const dx = Math.abs(x1 - x0);
    const dy = -Math.abs(y1 - y0);
    const sx = x0 < x1 ? 1 : -1;
    const sy = y0 < y1 ? 1 : -1;
    let err = dx + dy;
    for (let n = 0; n < 400; n++) {
      ctx.fillRect(x0, y0, 1, 1);
      if (x0 === x1 && y0 === y1) break;
      const e2 = 2 * err;
      if (e2 >= dy) {
        err += dy;
        x0 += sx;
      }
      if (e2 <= dx) {
        err += dx;
        y0 += sy;
      }
    }
  }

  const TRAIL = 48;
  const TRAIL_COLORS = ["#ece6da", "#9a948a", "#5a554e"];
  function drawOverlay(dt: number) {
    if (!octx || !overlay || !view) return;
    octx.clearRect(0, 0, overlay.width, overlay.height);
    const c = cameraBasis(view.el, view.az);
    const now = performance.now();
    for (let s = shots.length - 1; s >= 0; s--) {
      const shot = shots[s];
      const n = shot.pts.length / 3;
      shot.head = view.still ? n - 1 : Math.min(n - 1, shot.head + dt * 30);
      const head = Math.floor(shot.head);
      const done = head >= n - 1;
      const tail0 = view.still ? 0 : Math.max(0, head - TRAIL);
      // trail: three pixel shades, newest brightest
      let prev: [number, number] | null = null;
      for (let i = tail0; i <= head; i++) {
        const q = toPx(c, shot.pts, i * 3);
        if (q && prev) {
          const age = (head - i) / TRAIL;
          octx.fillStyle = TRAIL_COLORS[age < 0.3 ? 0 : age < 0.65 ? 1 : 2];
          line(octx, prev, q);
        }
        prev = q;
      }
      const hp = toPx(c, shot.pts, head * 3);
      if (hp && !done) {
        octx.fillStyle = "#ece6da";
        octx.fillRect(hp[0] - 1, hp[1], 3, 1);
        octx.fillRect(hp[0], hp[1] - 1, 1, 3);
      }
      // ember spark at the launch point, a flash where a photon falls in
      if (now - shot.born < 700) {
        const o = toPx(c, shot.pts, 0);
        if (o) {
          octx.fillStyle = "#e0442e";
          octx.fillRect(o[0] - 1, o[1] - 1, 3, 3);
        }
      }
      if (done && shot.captured && hp) {
        octx.fillStyle = "#e0442e";
        octx.fillRect(hp[0] - 1, hp[1], 3, 1);
        octx.fillRect(hp[0], hp[1] - 1, 1, 3);
      }
      if (done) {
        shot.born = Math.min(shot.born, now - 700);
        (shot as Shot & { doneAt?: number }).doneAt ??= now;
        if (now - ((shot as Shot & { doneAt?: number }).doneAt ?? now) > (view.still ? 4000 : 600)) shots.splice(s, 1);
      }
    }
    if (marker) {
      const [x, y] = marker;
      octx.fillStyle = "#e0442e";
      octx.fillRect(x - 2, y, 2, 1);
      octx.fillRect(x + 1, y, 2, 1);
      octx.fillRect(x, y - 2, 1, 2);
      octx.fillRect(x, y + 1, 1, 2);
    }
  }

  if (hero) {
    hero.addEventListener("pointerdown", (e) => {
      const t = e.target as Element | null;
      if (t?.closest("a, button, .readout")) return;
      // a launch click must not start a text selection (double clicks
      // would otherwise select the name)
      if (e.pointerType === "mouse") e.preventDefault();
      launch(e.clientX, e.clientY);
      if (view?.still) drawOverlay(0);
    });
  }

  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  if (hero && fine.matches) {
    hero.classList.add("can-inspect");
    hero.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      pointer = { x: e.clientX, y: e.clientY };
      if (view?.still) inspect();
    });
    hero.addEventListener("pointerleave", () => {
      pointer = null;
      marker = null;
      if (rayOut && performance.now() > shotText) rayOut.textContent = rayOut.dataset.hint || "";
    });
    if (rayOut) rayOut.dataset.hint = rayOut.textContent || "";
  } else if (rayOut) {
    rayOut.textContent = rayOut.dataset.hintTouch || "";
    rayOut.dataset.hint = rayOut.textContent;
  }

  if (hero && canvas && anchor) {
    try {
      const stop = mountBlackHole({
        canvas,
        overlay,
        anchor,
        root: hero,
        onFrame,
        onReady: () => hero.classList.add("is-gl"),
        onFail: () => hero.classList.remove("is-gl"),
      });
      if (!stop) hero.classList.add("no-gl");
    } catch (err) {
      console.error("[hero] black hole failed:", err);
      hero.classList.add("no-gl");
    }
  }

  // ---- the REPL line types itself once, then cycles its answers ----
  const repl = hero?.querySelector<HTMLElement>("[data-repl]");
  const input = repl?.querySelector<HTMLElement>("[data-repl-in]");
  const output = repl?.querySelector<HTMLElement>("[data-repl-out]");
  const cursor = repl?.querySelector<HTMLElement>("[data-repl-cursor]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (repl && input && output && cursor && !reduce) {
    const outputs: string[] = JSON.parse(repl.dataset.outputs || "[]");
    const command = input.textContent || "";
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const whenVisible = () =>
      document.hidden
        ? new Promise<void>((r) =>
            document.addEventListener("visibilitychange", () => r(), { once: true }),
          )
        : Promise.resolve();

    const type = async (el: HTMLElement, text: string, speed: number, jitter: number) => {
      for (let i = 1; i <= text.length; i++) {
        el.textContent = text.slice(0, i);
        await wait(speed + Math.random() * jitter);
      }
    };

    const run = async () => {
      repl.classList.add("is-typing");
      input.textContent = "";
      output.textContent = "";
      input.after(cursor);
      await wait(700);
      await type(input, command, 60, 60);
      await wait(420);
      output.after(cursor);
      let i = 0;
      for (;;) {
        await whenVisible();
        output.classList.remove("is-hidden");
        await type(output, outputs[i], 16, 14);
        await wait(4800);
        output.classList.add("is-hidden");
        await wait(300);
        output.textContent = "";
        i = (i + 1) % outputs.length;
      }
    };
    run();
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: 3.5rem;
    padding-bottom: clamp(4rem, 10svh, 7rem);
    overflow: hidden;
    /* where the hole sits; the renderer reads the anchor's box */
    --bh-x: 50%;
    --bh-y: 30%;
    --bh-d: min(116vw, 58svh);
    /* the render's scale over the anchor's circle (the static fallback keeps 1) */
    --bh-zoom: 0.95;
  }

  @media (min-width: 48rem) {
    .hero {
      --bh-x: 70%;
      --bh-y: 45%;
      --bh-d: min(54vw, 80svh);
      --bh-zoom: 1.3;
    }
  }

  /* ───────── art ───────── */

  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* sized in whole-pixel multiples by the renderer */
  .gl {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    opacity: 0;
  }
  .hero.is-gl .gl {
    opacity: 1;
  }

  .anchor {
    position: absolute;
    left: var(--bh-x);
    top: var(--bh-y);
    width: var(--bh-d);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  /* static fallback: shown until WebGL paints, and forever without it */
  .still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero.is-gl .still {
    display: none;
  }
  .still * {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-width: 2;
  }
  .still__ring {
    stroke: var(--bone);
  }
  .still__disk {
    stroke: var(--dust);
  }
  .still__hot {
    stroke: var(--ember);
  }
  .still .still__hole {
    fill: var(--ink);
    stroke: none;
  }

