---
/**
 * Hero: the title page. A real-time lensed Schwarzschild black hole
 * (src/scripts/blackhole.ts) behind a blackletter name and a REPL line.
 * All copy lives in HERO below.
 */
const HERO = {
  note: "CPython core developer since 2018 · Steering Council 2021–2026 · Release manager, 3.10 & 3.11",
  first: "Pablo",
  last: "Galindo Salgado",
  replInput: "pablo.occupation",
  replOutputs: [
    "makes the Python interpreter tell you what went wrong",
    "writes parsers, profilers and debuggers",
    "studied black holes, then built one: the parser",
    "co-hosts core.py",
  ],
  primary: { label: "Read the traceback", href: "#about" },
  secondary: { label: "Listen to core.py", href: "#corepy" },
  sigil: "import this · from __future__ import braces · SyntaxError: not a chance · ",
  plate: "Pl. I · Schwarzschild · i = 81°",
};

const repr = (s: string) => `'${s}'`;
const noteParts = HERO.note.split(" · ");
// circumference of the sigil text path (r = 106 in the SVG's user units)
const SIGIL_R = 106;
const sigilLen = 2 * Math.PI * SIGIL_R;
---

<section id="hero" class="hero" aria-labelledby="hero-name">
  <div class="art" aria-hidden="true">
    <canvas class="gl" data-bh-canvas></canvas>
    <div class="anchor" data-bh-anchor>
      <svg class="still" viewBox="-100 -100 200 200" focusable="false">
        <g transform="rotate(-7)">
          <circle r="63" class="still__faint"></circle>
          <circle r="42" class="still__faint"></circle>
          <ellipse rx="92" ry="11" class="still__disk"></ellipse>
          <ellipse rx="74" ry="8.6" class="still__disk"></ellipse>
          <ellipse rx="58" ry="6.6" class="still__disk"></ellipse>
          <ellipse rx="44" ry="5" class="still__disk still__hot"></ellipse>
          <path d="M -34 -2 A 34 30 0 0 1 34 -2" class="still__disk"></path>
          <path d="M -27 -2 A 27 23 0 0 1 27 -2" class="still__disk"></path>
          <circle r="20.5" class="still__ring"></circle>
          <circle r="19.5" class="still__hole"></circle>
          <path d="M -58 2.2 A 58 6.6 0 0 0 58 2.2" class="still__disk still__front"></path>
          <path d="M -44 1.6 A 44 5 0 0 0 44 1.6" class="still__disk still__front still__hot"></path>
        </g>
      </svg>
      <svg class="sigil" viewBox="-120 -120 240 240" focusable="false">
        <defs>
          <path
            id="hero-sigil-path"
            d={`M 0 -${SIGIL_R} A ${SIGIL_R} ${SIGIL_R} 0 1 1 0 ${SIGIL_R} A ${SIGIL_R} ${SIGIL_R} 0 1 1 0 -${SIGIL_R}`}
          ></path>
        </defs>
        <g class="sigil__spin">
          <circle r="101" class="sigil__line"></circle>
          <circle r="112.5" class="sigil__line"></circle>
          <text class="sigil__text">
            <textPath href="#hero-sigil-path" textLength={sigilLen.toFixed(1)} lengthAdjust="spacing">
              {HERO.sigil.repeat(3).replace(/ $/, "\u00a0")}
            </textPath>
          </text>
        </g>
        <g class="sigil__ticks">
          {
            Array.from({ length: 24 }, (_, i) => (
              <line
                x1="0"
                y1={i % 6 === 0 ? -116 : -114}
                x2="0"
                y2="-118"
                transform={`rotate(${i * 15})`}
              />
            ))
          }
        </g>
      </svg>
      <p class="plate label">{HERO.plate}</p>
    </div>
    <div class="scrim"></div>
  </div>

  <div class="wrap content">
    <p class="note label">
      {
        noteParts.map((part, i) => (
          <>
            {i > 0 && <span class="note__sep"> · </span>}
            <span class="note__part">{part}</span>
          </>
        ))
      }
    </p>

    <h1 id="hero-name" class="name display">
      <span class="name__first">{HERO.first}</span>
      <span class="name__last">{HERO.last}</span>
    </h1>

    <div class="repl mono" aria-hidden="true" data-repl data-outputs={JSON.stringify(HERO.replOutputs.map(repr))}>
      <p class="repl__in">
        <span class="repl__ps">&gt;&gt;&gt;</span>
        <span data-repl-in>{HERO.replInput}</span><span class="repl__cursor" data-repl-cursor></span>
      </p>
      <p class="repl__out">
        {HERO.replOutputs.map((o) => <span class="repl__ghost">{repr(o)}</span>)}
        <span class="repl__line"><span class="repl__live" data-repl-out>{repr(HERO.replOutputs[0])}</span></span>
      </p>
    </div>
    <p class="visually-hidden">
      {HERO.replInput}: {HERO.replOutputs.join("; ")}.
    </p>

    <div class="actions">
      <a class="btn btn--solid" href={HERO.primary.href}>
        {HERO.primary.label} <span aria-hidden="true">↓</span>
      </a>
      <a class="btn" href={HERO.secondary.href}>{HERO.secondary.label}</a>
    </div>
  </div>

  <a class="scroll label" href={HERO.primary.href} aria-hidden="true" tabindex="-1">
    <span>scroll</span>
    <span class="scroll__line"></span>
  </a>
</section>

<script>
  import { mountBlackHole } from "../scripts/blackhole";

  const hero = document.getElementById("hero");
  const canvas = hero?.querySelector<HTMLCanvasElement>("[data-bh-canvas]");
  const anchor = hero?.querySelector<HTMLElement>("[data-bh-anchor]");

  if (hero && canvas && anchor) {
    const stop = mountBlackHole({
      canvas,
      anchor,
      root: hero,
      onReady: () => hero.classList.add("is-gl"),
      onFail: () => hero.classList.remove("is-gl"),
    });
    if (!stop) hero.classList.add("no-gl");
  }

  // ---- the REPL line types itself once, then cycles its answers ----
  const repl = hero?.querySelector<HTMLElement>("[data-repl]");
  const input = repl?.querySelector<HTMLElement>("[data-repl-in]");
  const output = repl?.querySelector<HTMLElement>("[data-repl-out]");
  const cursor = repl?.querySelector<HTMLElement>("[data-repl-cursor]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (repl && input && output && cursor && !reduce) {
    const outputs: string[] = JSON.parse(repl.dataset.outputs || "[]");
    const command = input.textContent || "";
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const whenVisible = () =>
      document.hidden
        ? new Promise<void>((r) =>
            document.addEventListener("visibilitychange", () => r(), { once: true }),
          )
        : Promise.resolve();

    const type = async (el: HTMLElement, text: string, speed: number, jitter: number) => {
      for (let i = 1; i <= text.length; i++) {
        el.textContent = text.slice(0, i);
        await wait(speed + Math.random() * jitter);
      }
    };

    const run = async () => {
      repl.classList.add("is-typing");
      input.textContent = "";
      output.textContent = "";
      input.after(cursor);
      await wait(700);
      await type(input, command, 60, 60);
      await wait(420);
      output.after(cursor);
      let i = 0;
      for (;;) {
        await whenVisible();
        output.classList.remove("is-fading");
        await type(output, outputs[i], 16, 14);
        await wait(4800);
        output.classList.add("is-fading");
        await wait(450);
        output.textContent = "";
        i = (i + 1) % outputs.length;
      }
    };
    run();
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: 3.5rem;
    padding-bottom: clamp(5rem, 11svh, 7.5rem);
    overflow: hidden;
    /* where the hole sits; the WebGL renderer reads the anchor's box */
    --bh-x: 50%;
    --bh-y: 29%;
    --bh-d: min(116vw, 58svh);
  }

  @media (min-width: 48rem) {
    .hero {
      --bh-x: 67%;
      --bh-y: 45%;
      --bh-d: min(54vw, 80svh);
    }
  }

  /* ───────── art ───────── */

  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s ease;
  }

  .hero.is-gl .gl {
    opacity: 1;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--ink) 0, transparent 7rem),
      linear-gradient(
        to top,
        var(--ink) 0,
        color-mix(in srgb, var(--ink) 86%, transparent) 26%,
        color-mix(in srgb, var(--ink) 40%, transparent) 46%,
        transparent 62%
      );
  }

  @media (min-width: 48rem) {
    .scrim {
      background:
        linear-gradient(to bottom, var(--ink) 0, transparent 7rem),
        linear-gradient(to top, var(--ink) 0, transparent 22%),
        linear-gradient(
          to right,
          var(--ink) 0,
          color-mix(in srgb, var(--ink) 82%, transparent) 22%,
          color-mix(in srgb, var(--ink) 35%, transparent) 42%,
          transparent 58%
        );
    }
  }

  .anchor {
    position: absolute;
    left: var(--bh-x);
    top: var(--bh-y);
    width: var(--bh-d);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  /* static fallback: shown until WebGL paints, and forever without it */
  .still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transition: opacity 1.2s ease;
  }
  .hero.is-gl .still {
    opacity: 0;
  }
  .still * {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
  }
  .still__faint {
    stroke: var(--line-2);
  }
  .still__disk {
    stroke: var(--ash);
    stroke-opacity: 0.55;
  }
  .still__front {
    stroke: var(--bone);
    stroke-opacity: 0.9;
  }
  .still__hot {
    stroke: var(--ember);
    stroke-opacity: 0.8;
  }
  .still__ring {
    stroke: var(--bone);
    stroke-opacity: 0.6;
  }
  .still .still__hole {
    fill: var(--ink);
    stroke: none;
  }

  .sigil {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    overflow: visible;
  }
  .sigil__spin {
    animation: sigil-spin 360s linear infinite;
    transform-origin: 0 0;
  }
  .sigil__line {
    fill: none;
    stroke: var(--line-2);
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
  }
  .sigil__ticks line {
    stroke: var(--dust);
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
  }
  .sigil__text {
    font-family: var(--f-mono);
    font-size: 4.1px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--dust);
  }
  @keyframes sigil-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sigil__spin {
      animation: none;
    }
  }
  @media (max-width: 47.99rem) {
    .sigil__text {
      display: none;
    }
  }

  .plate {
    position: absolute;
    top: calc(100% + 1.6rem);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    white-space: nowrap;
    font-size: 0.62rem;
    color: var(--dust);
  }
  @media (max-width: 47.99rem) {
    .plate {
      display: none;
    }
  }

  /* ───────── content ───────── */

  .content {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.1em;
    row-gap: 0.3em;
    max-width: 44rem;
    color: var(--ash);
  }
  .note::before {
    content: "";
    display: inline-block;
    width: 1.6rem;
    height: 1px;
    margin-right: 0.8em;
    background: var(--ember);
    align-self: center;
  }
  .note__sep {
    color: var(--dust);
    white-space: pre;
  }
  .note__part {
    white-space: nowrap;
  }

  .name {
    display: grid;
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.005em;
    color: var(--bone);
    text-wrap: balance;
    margin-top: var(--space-2);
  }
  .name__last {
    color: var(--bone);
  }

  .repl {
    display: grid;
    gap: 0.35em;
    max-width: 40rem;
    font-size: var(--step--1);
    line-height: 1.5;
    margin-top: var(--space-2);
  }
  .repl p {
    margin: 0;
  }
  .repl__ps {
    color: var(--ember);
  }
  .repl__in {
    color: var(--bone);
  }
  .repl__out {
    display: grid;
    color: var(--ash);
  }
  .repl__out > * {
    grid-area: 1 / 1;
  }
  .repl__ghost {
    visibility: hidden;
  }
  .repl__live {
    transition: opacity 0.4s ease;
  }
  .repl__live.is-fading {
    opacity: 0;
  }
  .repl__ghost::after {
    content: "\a0\a0";
  }
  .repl__cursor {
    display: none;
  }
  .repl.is-typing .repl__cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.1em;
    vertical-align: -0.18em;
    background: var(--bone);
    opacity: 0.8;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .scroll {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-5);
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    font-size: 0.62rem;
    color: var(--dust);
    text-decoration: none;
  }
  .scroll:hover {
    color: var(--ash);
  }
  .scroll__line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: var(--line-2);
    overflow: hidden;
  }
  .scroll__line::after {
    content: "";
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--bone);
    animation: drip 2.8s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes drip {
    to {
      top: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll__line::after {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    .scroll {
      right: auto;
      left: 50%;
      transform: translateX(-50%);
    }
  }
  @media (max-height: 40rem) {
    .scroll {
      display: none;
    }
  }
</style>
