---
import SectionHead from "./SectionHead.astro";
import {
  intro,
  stats,
  statsSource,
  axis,
  offices,
  milestones,
  peps,
  pepUrl,
  upcomingVersion,
  releases,
  type DemoLine,
  type Pep,
} from "../data/cpython";

/* ── tiny renderers ── */
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

/** escape, then turn `code` into <code>code</code> */
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");

function line(l: DemoLine): string {
  const t = l.t ?? "";
  switch (l.k) {
    case "cmd":
      return `<span class="t-dim">$ </span><span class="t-bone">${esc(t)}</span>`;
    case "prompt":
      return `<span class="t-prompt">&gt;&gt;&gt; </span><span class="t-bone">${esc(t)}</span>`;
    case "src":
      return `<span class="t-bone">${esc(t)}</span>`;
    case "caret":
      return esc(t)
        .replace(/(\^+)/g, '<span class="t-caret">$1</span>')
        .replace(/(~+)/g, '<span class="t-tilde">$1</span>');
    case "err": {
      const i = t.indexOf(":");
      const name = t.slice(0, i);
      let msg = esc(t.slice(i));
      msg = msg.replace(/(Did you mean: )(&#39;|')([^']+)'/, '$1<span class="t-hint">\'$3\'</span>');
      return `<span class="t-exc">${esc(name)}</span><span class="t-bone">${msg}</span>`;
    }
    case "blank":
      return "";
    default:
      return esc(t);
  }
}
const renderLines = (ls: DemoLine[]) => ls.map(line).join("\n");

/* ── timeline geometry ── */
const span = axis.to - axis.from;
const pct = (x: number) => `${(((x - axis.from) / span) * 100).toFixed(3)}%`;
const years = Array.from({ length: span }, (_, i) => axis.from + i);
const lanes = [...offices].sort((a, b) => a.from - b.from);
const keyOf = (i: number) => String.fromCharCode(97 + i); // a, b, c…

/* ── PEP index ── */
const featured = peps.filter((p) => p.featured);
const others = peps.filter((p) => !p.featured);
const count = (s: Pep["status"]) => peps.filter((p) => p.status === s).length;
const tally = [
  { n: count("Final"), s: "final" },
  { n: count("Active"), s: "active" },
  { n: count("Rejected"), s: "rejected" },
  { n: count("Withdrawn"), s: "withdrawn" },
];

function withWhom(names: string[]): string {
  if (names.length === 0) return "";
  if (names.length > 4) return `with ${names.length} co-authors`;
  if (names.length === 1) return `with ${names[0]}`;
  return `with ${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
}

/* sigil ring: every PEP number around a circle */
const ring = peps.map((p) => p.number).join(" · ") + " · ";

let fig = 0;
---

<section id="cpython" class="wrap cpy">
  <SectionHead num={intro.num} title={intro.title} kicker={intro.kicker} lede={intro.lede} />

  <svg class="sigil" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <defs>
      <path id="cpy-ring" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0"></path>
    </defs>
    <circle cx="100" cy="100" r="95" class="s-line"></circle>
    <circle cx="100" cy="100" r="92.5" class="s-tick"></circle>
    <circle cx="100" cy="100" r="68" class="s-line"></circle>
    <g class="s-spin">
      <text class="s-text">
        <textPath href="#cpy-ring" textLength="500" lengthAdjust="spacing">{ring}</textPath>
      </text>
    </g>
    <line x1="100" y1="40" x2="100" y2="160" class="s-faint"></line>
    <line x1="40" y1="100" x2="160" y2="100" class="s-faint"></line>
    <text x="100" y="112" class="s-core">§</text>
  </svg>

  <!-- ─────────────── by the numbers ─────────────── -->
  <div class="block">
    <h3 class="visually-hidden">By the numbers</h3>
    <dl class="stats reveal">
      {
        stats.map((s) => (
          <div class="stat">
            <dt class="label stat__k">{s.label}</dt>
            <dd class="stat__v display">
              {s.value.startsWith("#") ? (
                <><span class="stat__hash">#</span>{s.value.slice(1)}</>
              ) : (
                s.value
              )}
            </dd>
            {s.versions && (
              <dd class="stat__vers mono">
                {s.versions.map((v) => (
                  <span class="ver">{v}</span>
                ))}
              </dd>
            )}
            {s.series && (
              <dd class="spark">
                <span
                  class="spark__bars"
                  role="img"
                  aria-label={`Merged pull requests per year: ${s.series.map((d) => `${d.year}, ${d.n}`).join("; ")}`}
                >
                  {s.series.map((d) => {
                    const max = Math.max(...s.series!.map((x) => x.n));
                    return (
                      <span
                        class="spark__bar"
                        style={`--h:${((d.n / max) * 100).toFixed(1)}%`}
                        title={`${d.year}: ${d.n}`}
                      />
                    );
                  })}
                </span>
                <span class="spark__axis mono" aria-hidden="true">
                  <span>{s.series[0].year}</span>
                  <span>{s.series.at(-1)!.year}</span>
                </span>
              </dd>
            )}
            {s.note && <dd class="stat__note">{s.note}</dd>}
          </div>
        ))
      }
    </dl>
    <p class="label stats__src">Counts from {statsSource}</p>
  </div>

  <!-- ─────────────── offices ─────────────── -->
  <div class="block">
    <header class="subhead reveal">
      <span class="subhead__num mono">II.i</span>
      <h3 class="display subhead__title">Offices held</h3>
      <span class="label subhead__note">git log --reverse</span>
    </header>

    <figure class="chrono reveal">
      <div class="plot">
        <div class="field" aria-hidden="true">
          <span class="now" style={`left:${pct(axis.now)}`}><span class="now__label mono">now</span></span>
        </div>

        <div class="row row--axis" aria-hidden="true">
          <span class="row__name"></span>
          <span class="track track--axis">
            {
              years.map((y) => (
                <span class="year mono" style={`left:${pct(y)}`}>
                  <span class="year__full">{y}</span>
                  <span class="year__short">’{String(y).slice(2)}</span>
                </span>
              ))
            }
          </span>
        </div>

        <ul class="lanes">
          {
            lanes.map((o) => {
              const end = o.to ?? axis.now;
              return (
                <li class:list={["row lane", { "lane--accent": o.accent, "lane--open": !o.to }]}>
                  <span class="row__name">
                    {o.href ? <a href={o.href}>{o.role}</a> : o.role}
                    <span class="lane__range mono">{o.range}</span>
                    {o.note && <span class="lane__note">{o.note}</span>}
                  </span>
                  <span class="track" aria-hidden="true">
                    <span class="bar" style={`left:${pct(o.from)};width:calc(${pct(end)} - ${pct(o.from)})`}>
                      {o.segments &&
                        Array.from({ length: o.segments }, (_, i) => (
                          <span class="seg">{String(Math.floor(o.from) + i).slice(2)}</span>
                        ))}
                    </span>
                  </span>
                </li>
              );
            })
          }
        </ul>

        <div class="row row--ticks" aria-hidden="true">
          <span class="row__name label">Milestones</span>
          <span class="track track--ticks">
            {
              milestones.map((m, i) => (
                <span class="tick" style={`left:${pct(m.at)}`}>
                  <span class="tick__key mono">{keyOf(i)}</span>
                </span>
              ))
            }
          </span>
        </div>
      </div>

      <ol class="key">
        {
          milestones.map((m, i) => (
            <li class="key__item">
              <span class="key__mark mono" aria-hidden="true">
                {keyOf(i)}
              </span>
              <span class="key__date mono">{m.date}</span>
              <span class="key__title">{m.href ? <a href={m.href}>{m.title}</a> : m.title}</span>
              {m.detail && <span class="key__detail">{m.detail}</span>}
            </li>
          ))
        }
      </ol>
    </figure>
  </div>

  <!-- ─────────────── PEPs ─────────────── -->
  <div class="block">
    <header class="subhead reveal">
      <span class="subhead__num mono">II.ii</span>
      <h3 class="display subhead__title">Sealed proposals</h3>
      <span class="label subhead__note">peps.python.org</span>
    </header>
    <p class="block__lede reveal">
      Fifteen PEPs with my name on them. Most shipped, two are the release calendars I
      kept, and two didn't make it, which is also how the process is meant to work.
      <span class="tally mono">
        {tally.map((t) => <span class={`tally__i tally__i--${t.s}`}>{t.n} {t.s}</span>)}
      </span>
    </p>

    {
      [featured, others].map((list, li) => (
        <ol class:list={["peps", li === 0 ? "peps--major" : "peps--minor"]}>
          {list.map((p) => {
            const dead = p.status === "Rejected" || p.status === "Withdrawn";
            const soon = p.version === upcomingVersion && !p.target;
            return (
              <li class:list={["pep reveal", `pep--${p.status.toLowerCase()}`]} id={`pep-${p.number}`}>
                <div class="pep__top">
                  <span class="pep__num mono">
                    <span class="pep__pre">PEP</span>
                    {p.number}
                  </span>
                  <span class={`seal seal--${p.status.toLowerCase()} mono`}>{p.status}</span>
                </div>
                <h4 class="pep__title">
                  <a class="pep__link" href={pepUrl(p.number)}>
                    {p.title}
                  </a>
                </h4>
                <p class="pep__desc" set:html={md(p.description)} />
                {p.coauthors.length > 0 && <p class="pep__with">{withWhom(p.coauthors)}</p>}
                <p class="pep__foot mono">
                  {p.version === null ? (
                    <span class="pep__meta">process</span>
                  ) : p.target ? (
                    <span class="pep__meta">
                      aimed at <s>{p.version}</s>
                    </span>
                  ) : (
                    <span class="ver">
                      {p.version}
                      {soon && <span class="pep__meta"> coming</span>}
                    </span>
                  )}
                  <span class="pep__go" aria-hidden="true">
                    {dead ? "read the post-mortem" : "read"} ↗
                  </span>
                </p>
              </li>
            );
          })}
        </ol>
      ))
    }
  </div>

  <!-- ─────────────── changelog ─────────────── -->
  <div class="block">
    <header class="subhead reveal">
      <span class="subhead__num mono">II.iii</span>
      <h3 class="display subhead__title">What's New, abridged</h3>
      <span class="label subhead__note">sys.version_info</span>
    </header>
    <p class="block__lede reveal">
      The parts of each release I wrote, co-wrote or argued into existence. Sources link to the
      What's New entries and the original issues.
    </p>

    <ol class="log">
      {
        releases.map((r) => (
          <li class:list={["rel", { "rel--soon": r.upcoming }]} id={`py${r.version.replace(".", "")}`}>
            <div class="rel__head reveal">
              <h4 class="rel__v mono">
                <span class="visually-hidden">Python </span>
                {r.version}
              </h4>
              <p class="rel__when label">
                {r.upcoming ? (
                  <>
                    <span>in development</span>
                    <span>{r.when}</span>
                  </>
                ) : (
                  r.when
                )}
                {r.rm && <span class="rel__rm">release manager</span>}
              </p>
            </div>

            <div class="rel__body">
              <ul class="feats">
                {r.features.map((f) => (
                  <li class="feat reveal">
                    <h5 class="feat__name">
                      {f.name}
                      {f.span && <span class="feat__span mono">{f.span}</span>}
                    </h5>
                    <p class="feat__desc" set:html={md(f.description)} />
                    <p class="feat__src mono">
                      {f.pep && (
                        <a class="xref" href={`#pep-${f.pep}`}>
                          PEP {f.pep}
                        </a>
                      )}
                      {f.sources.map((s) => (
                        <a href={s.href}>{s.label}</a>
                      ))}
                    </p>
                  </li>
                ))}
              </ul>

              {r.demo && (
                <figure class:list={["demo reveal", { "demo--pair": r.demo.panes.length > 1 }]}>
                  <figcaption class="demo__cap">
                    <span class="label demo__fig">Fig. II.{++fig}</span>
                    <span class="demo__title">{/[.?!]$/.test(r.demo.title) ? r.demo.title : `${r.demo.title}.`}</span> <span class="demo__note">{r.demo.caption}</span>
                  </figcaption>
                  <div class="demo__panes">
                    {r.demo.panes.map((pane) => (
                      <div class:list={["term", { "term--before": pane.before }]}>
                        <p class="term__bar label">
                          <span>{pane.label}</span>
                          {pane.before && <span>before</span>}
                        </p>
                        <pre tabindex="0"><code set:html={renderLines(pane.lines)} /></pre>
                      </div>
                    ))}
                  </div>
                </figure>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cpy {
    position: relative;
    padding-top: var(--space-8);
  }

  .block {
    margin-top: var(--space-7);
  }
  .block:first-of-type {
    margin-top: 0;
  }
  .block__lede {
    max-width: 40rem;
    margin-bottom: var(--space-6);
    color: var(--ash);
  }

  /* ── sigil ── */
  .sigil {
    display: none;
  }
  @media (min-width: 60rem) {
    .sigil {
      display: block;
      position: absolute;
      top: calc(var(--space-8) + 3.25rem);
      right: var(--gutter);
      width: clamp(10rem, 16vw, 14rem);
      height: auto;
      overflow: visible;
    }
  }
  .s-line {
    fill: none;
    stroke: var(--line-2);
    stroke-width: 0.6;
  }
  .s-tick {
    fill: none;
    stroke: var(--dust);
    stroke-width: 3;
    stroke-dasharray: 0.4 4.44;
    opacity: 0.7;
  }
  .s-faint {
    stroke: var(--line);
    stroke-width: 0.6;
  }
  .s-text {
    font-family: var(--f-mono);
    font-size: 8.4px;
    fill: var(--ash);
    letter-spacing: 0.05em;
  }
  .s-core {
    font-family: var(--f-display);
    font-size: 40px;
    fill: var(--ember);
    text-anchor: middle;
  }
  .s-spin {
    transform-origin: 100px 100px;
    animation: cpy-spin 180s linear infinite;
  }
  @keyframes cpy-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── sub-headings ── */
  .subhead {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .subhead__num {
    color: var(--ember);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
  }
  .subhead__title {
    font-size: var(--step-3);
  }
  .subhead__note {
    grid-column: 2;
  }
  @media (min-width: 48rem) {
    .subhead {
      grid-template-columns: auto auto 1fr;
    }
    .subhead__note {
      grid-column: 3;
      justify-self: end;
    }
  }

  /* ── stats ── */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line);
    border-block: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 72rem) {
    .stats {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4) var(--space-4);
    background: var(--ink);
  }
  .stat dd {
    margin: 0;
  }
  .stat__k {
    order: 2;
    color: var(--ash);
  }
  .stat__v {
    order: 1;
    font-size: clamp(2.9rem, 1.7rem + 3vw, 4.4rem);
    line-height: 0.9;
    font-variant-numeric: lining-nums;
    font-feature-settings: "lnum";
  }
  .stat__hash {
    color: var(--ember);
    font-size: 0.6em;
    vertical-align: 0.5em;
    margin-right: 0.05em;
  }
  .stat__vers,
  .spark,
  .stat__note {
    order: 3;
  }
  .stat__note {
    margin-top: auto;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--dust);
    line-height: 1.3;
  }
  .stat__vers {
    display: flex;
    gap: var(--space-3);
    margin-top: auto;
    font-size: var(--step--1);
  }
  .ver {
    font-family: var(--f-mono);
    color: var(--gold);
    letter-spacing: 0.02em;
  }
  .spark {
    display: grid;
    gap: 3px;
    margin-top: var(--space-1);
  }
  .spark__bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 1.6rem;
    border-bottom: 1px solid var(--line-2);
  }
  .spark__bar {
    flex: 1;
    height: var(--h);
    min-height: 1px;
    background: var(--dust);
    transition: background 0.2s;
  }
  .spark__bar:hover {
    background: var(--bone);
  }
  .spark__bar:last-child {
    background: repeating-linear-gradient(135deg, var(--dust) 0 1px, transparent 1px 3px);
  }
  .spark__axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    color: var(--dust);
  }
  .stats__src {
    margin-top: var(--space-3);
    text-align: right;
    font-size: 0.62rem;
  }

  /* ── offices timeline ── */
  .chrono {
    margin: 0;
    --lab: 0px;
    --gap: 0px;
  }
  @media (min-width: 48rem) {
    .chrono {
      --lab: 15rem;
      --gap: var(--space-5);
    }
  }
  .plot {
    position: relative;
    display: grid;
    padding-bottom: var(--space-2);
  }
  .field {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--lab) + var(--gap));
    right: 0;
    pointer-events: none;
    background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
    background-size: 10% 100%;
    border-right: 1px solid var(--line);
  }
  .now {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px dashed var(--ember-dim);
  }
  .now__label {
    position: absolute;
    top: 0.1rem;
    left: 0.35rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    column-gap: var(--gap);
    row-gap: var(--space-1);
  }
  @media (min-width: 48rem) {
    .row {
      grid-template-columns: var(--lab) minmax(0, 1fr);
    }
  }
  .track {
    position: relative;
    display: block;
    height: 0.9rem;
  }
  .row--axis {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-2);
    margin-top: var(--space-5);
  }
  .row--axis .row__name {
    display: none;
  }
  @media (min-width: 48rem) {
    .row--axis .row__name {
      display: block;
    }
  }
  .year {
    position: absolute;
    bottom: 0;
    padding-left: 0.35em;
    font-size: var(--step--2);
    color: var(--dust);
    white-space: nowrap;
  }
  .year__full {
    display: none;
  }
  @media (min-width: 60rem) {
    .year__full {
      display: inline;
    }
    .year__short {
      display: none;
    }
  }

  .lanes {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lane {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .lane .row__name {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--step-0);
    line-height: 1.25;
  }
  @media (min-width: 48rem) {
    .lane .row__name {
      display: grid;
      gap: 0.1rem;
    }
  }
  .lane .row__name a {
    text-decoration: none;
  }
  .lane .row__name a:hover {
    text-decoration: underline;
  }
  .lane__range {
    font-size: var(--step--2);
    color: var(--dust);
    white-space: nowrap;
  }
  .lane__note {
    flex-basis: 100%;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--dust);
    line-height: 1.2;
  }
  .bar {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    gap: 2px;
    border: 1px solid var(--ash);
    background: repeating-linear-gradient(
      135deg,
      var(--ash) 0 1px,
      transparent 1px 4px
    );
  }
  .lane--open .bar {
    border-right: 0;
  }
  .lane--open .bar::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    width: 0.9rem;
    border-top: 1px dotted var(--ash);
  }
  .lane--accent .bar {
    border: 0;
    background: none;
  }
  .seg {
    flex: 1;
    display: grid;
    place-items: center;
    background: var(--ember);
    color: var(--ink);
    font-family: var(--f-mono);
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
