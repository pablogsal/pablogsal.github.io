---
import SectionHead from "./SectionHead.astro";
import {
  intro,
  stats,
  statsSource,
  prsByYear,
  offices,
  peps,
  pepSummary,
  upcomingVersion,
  releases,
  type DemoLine,
} from "../data/cpython";

/* ── tiny renderers ── */
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

/** escape, then turn `code` into <code>code</code> */
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");

function line(l: DemoLine): string {
  const t = l.t ?? "";
  switch (l.k) {
    case "cmd":
      return `<span class="t-dim">$ </span><span class="t-bone">${esc(t)}</span>`;
    case "prompt":
      return `<span class="t-ember">&gt;&gt;&gt; </span><span class="t-bone">${esc(t)}</span>`;
    case "src":
      return `<span class="t-bone">${esc(t)}</span>`;
    case "caret":
      return esc(t)
        .replace(/(\^+)/g, '<span class="t-ember">$1</span>')
        .replace(/(~+)/g, '<span class="t-dim">$1</span>');
    case "err": {
      const i = t.indexOf(":");
      return `<span class="t-ember">${esc(t.slice(0, i))}</span><span class="t-bone">${esc(t.slice(i))}</span>`;
    }
    case "blank":
      return "";
    default:
      return esc(t);
  }
}

/* ── merged PRs per year as a column of squares ── */
const PER_SQUARE = 20;
const squares = prsByYear.map((d) => ({ ...d, sq: Math.max(1, Math.round(d.n / PER_SQUARE)) }));
const rows = Math.max(...squares.map((d) => d.sq));
const partial = prsByYear.find((d) => d.partial);
const chartLabel = `Merged pull requests per year: ${prsByYear
  .map((d) => `${d.year}, ${d.n}${d.partial ? " so far" : ""}`)
  .join("; ")}`;

/* ── PEPs ── */
const featured = peps.filter((p) => p.featured);
const others = peps.filter((p) => !p.featured);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, "-");

/* ── releases, newest first; one terminal demo ── */
const log = [...releases].reverse();
const demoRelease = releases.find((r) => r.demo);
const demo = demoRelease?.demo;
---

<section id="cpython" class="wrap cpy">
  <SectionHead num={intro.num} title={intro.title} kicker={intro.kicker} lede={intro.lede} />

  <!-- numbers -->
  <div class="reveal">
    <h3 class="visually-hidden">Numbers</h3>
    <dl class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dt class="label">{s.label}</dt>
            <dd class="display stat__v">{s.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="label src">Counts from {statsSource}.</p>
  </div>

  <!-- roles + chart -->
  <div class="block duo">
    <div class="reveal">
      <h3 class="display sub">Roles</h3>
      <dl class="roles">
        {
          offices.map((o) => (
            <div class="role">
              <dt>{o.href ? <a href={o.href}>{o.role}</a> : o.role}</dt>
              <dd class="label">{o.range}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="chart reveal">
      <figcaption class="display sub">Merged pull requests</figcaption>
      <div class="bars" role="img" aria-label={chartLabel} style={`--rows:${rows}`}>
        {
          squares.map((d) => (
            <div class="col" title={`${d.year}: ${d.n}${d.partial ? " so far" : ""}`}>
              {Array.from({ length: d.sq }, () => (
                <span class:list={["sq", { "sq--partial": d.partial }]} />
              ))}
              <span class="yr label">{d.year.slice(2)}</span>
            </div>
          ))
        }
      </div>
      <p class="label chart__key">
        One square is {PER_SQUARE} pull requests, by year opened.{partial && ` ${partial.year} is not complete.`}
      </p>
    </figure>
  </div>

  <!-- PEPs -->
  <div class="block">
    <h3 class="display sub reveal">PEPs</h3>
    <p class="lede reveal">{pepSummary}</p>

    <ol class="cards">
      {
        featured.map((p) => (
          <li class="card reveal" id={`pep-${p.number}`}>
            <p class="card__top label">
              <span class="ember">PEP {p.number}</span>
              {p.version && <span>{p.version}</span>}
            </p>
            <h4 class="card__title">
              <a href={p.url} set:html={md(p.title)} />
            </h4>
            <p class="card__desc" set:html={md(p.description)} />
          </li>
        ))
      }
    </ol>

    <ol class="list reveal">
      {
        others.map((p) => (
          <li class="row" id={`pep-${p.number}`}>
            <span class="label row__num">{p.number}</span>
            <a class="row__title" href={p.url} set:html={md(p.title)} />
            <span class={`label tag tag--${slug(p.status)}`}>{p.status}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- changes by release -->
  <div class="block">
    <h3 class="display sub reveal">Changes by release</h3>
    <p class="lede reveal">
      These are the changes I wrote or co-wrote in each release. Each one links to What's New and to the issue.
    </p>

    <ol class="rels reveal">
      {
        log.map((r, i) => (
          <li id={`py${r.version.replace(".", "")}`}>
            <details class="rel" open={i === 0}>
              <summary class="rel__sum">
                <span class="display rel__v">
                  <span class="visually-hidden">Python </span>
                  {r.version}
                </span>
                <span class="rel__names">{r.features.map((f) => f.name).join(" / ")}</span>
                <span class="label rel__when">
                  {r.upcoming ? "in development" : r.when}
                  {r.rm && <span class="ember"> RM</span>}
                </span>
                <span class="label rel__mark" aria-hidden="true" />
              </summary>
              <ul class="feats">
                {r.features.map((f) => (
                  <li class="feat">
                    <h4 class="feat__name">{f.name}</h4>
                    <p class="feat__desc" set:html={md(f.description)} />
                    <p class="feat__src label">
                      {f.pep && <a href={`#pep-${f.pep}`}>PEP {f.pep}</a>}
                      {f.sources.map((s) => (
                        <a href={s.href}>{s.label}</a>
                      ))}
                    </p>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ol>

    {
      demo && (
        <figure class="term reveal">
          {demo.panes.map((pane) => (
            <>
              <p class="term__bar label">{pane.label}</p>
              <pre tabindex="0"><code set:html={pane.lines.map(line).join("\n")} /></pre>
            </>
          ))}
          <figcaption class="term__cap">{demo.caption}</figcaption>
        </figure>
      )
    }
  </div>
</section>

<style>
  .cpy {
    padding-top: var(--space-8);
  }
  .block {
    margin-top: var(--space-7);
  }
  .sub {
    font-size: var(--step-3);
    line-height: 1;
    margin-bottom: var(--space-4);
  }
  .lede {
    max-width: 40rem;
    margin-bottom: var(--space-5);
    color: var(--ash);
  }
  .ember {
    color: var(--ember);
  }

  /* ── numbers ── */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 2px solid var(--line-2);
  }
  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3) var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .stat dd {
    margin: 0;
  }
  .stat .label {
    color: var(--ash);
  }
  .stat__v {
    font-size: var(--step-4);
    line-height: 0.85;
  }
  .src {
    margin-top: var(--space-3);
  }

  /* ── roles + chart ── */
  .duo {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 60rem) {
    .duo {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
  .roles {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .role {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .role dd {
    margin: 0;
  }

  .chart {
    margin: 0;
  }
  .bars {
    --sq: 12px;
    --gap: 4px;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    min-height: calc(var(--rows) * (var(--sq) + var(--gap)) + 1.5rem);
    padding-top: var(--space-2);
    border-bottom: 2px solid var(--line-2);
  }
  .col {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: var(--gap);
    flex: 1 1 0;
    max-width: 2rem;
  }
  .sq {
    display: block;
    width: var(--sq);
    height: var(--sq);
    background: var(--bone);
  }
  .sq--partial {
    background: var(--dither-50);
    background-size: 2px 2px;
    image-rendering: pixelated;
    box-shadow: inset 0 0 0 2px var(--bone);
  }
  .yr {
    order: -1;
    margin-top: 2px;
    line-height: 1;
  }
  .chart__key {
    margin-top: var(--space-3);
  }

  /* ── PEPs ── */
  .cards {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4) var(--space-4);
    border: 2px solid var(--line-2);
    background: var(--ink);
    box-shadow: 4px 4px 0 var(--ink-3);
  }
  .card:hover {
    border-color: var(--bone);
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .card__title {
    font-family: var(--f-body);
    font-size: 1em;
    font-weight: 600;
    line-height: 1.35;
  }
  .card__title a {
    text-decoration: none;
  }
  .card__desc {
    color: var(--ash);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }
  .row__num {
    color: var(--ember);
  }
  .row__title {
    text-decoration: none;
  }
  .row__title:hover {
    text-decoration: underline;
  }
  .tag {
    color: var(--ash);
  }
  .tag--active {
    color: var(--bone);
  }
  .tag--rejected,
  .tag--withdrawn,
  .tag--deferred,
  .tag--superseded {
    color: var(--dust);
  }

  :global(.cpy code) {
    font-size: 0.95em;
    color: var(--bone);
  }

  /* ── changes by release ── */
  .rels {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .rel {
    border-bottom: 1px solid var(--line);
  }
  .rel__sum {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    grid-template-areas:
      "v when mark"
      "names names names";
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-3) 0;
    cursor: pointer;
    list-style: none;
  }
  .rel__sum::-webkit-details-marker {
    display: none;
  }
  @media (min-width: 48rem) {
    .rel__sum {
      grid-template-columns: 4.5rem minmax(0, 1fr) 9rem 1.5rem;
      grid-template-areas: "v names when mark";
    }
  }
  .rel__v {
    grid-area: v;
    font-size: var(--step-3);
    line-height: 1;
  }
  .rel__names {
    grid-area: names;
    color: var(--ash);
    font-size: var(--step--1);
  }
  .rel__when {
    grid-area: when;
  }
  .rel__mark {
    grid-area: mark;
    justify-self: end;
    color: var(--bone);
  }
  .rel__mark::before {
    content: "+";
  }
  .rel[open] .rel__mark::before {
    content: "-";
  }
  .rel__sum:hover .rel__v,
  .rel__sum:hover .rel__mark {
    color: var(--ember);
  }
  .rel[open] .rel__names {
    display: none;
  }

  .feats {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-2) 0 var(--space-5);
    list-style: none;
  }
  @media (min-width: 48rem) {
    .feats {
      padding-left: calc(4.5rem + var(--space-3));
    }
  }
  .feat {
    max-width: 44rem;
  }
  .feat__name {
    font-family: var(--f-body);
    font-size: 1em;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: var(--space-1);
  }
  .feat__desc {
    color: var(--ash);
    font-size: var(--step--1);
  }
  .feat__src {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-2);
  }
  .feat__src a {
    color: var(--dust);
  }
  .feat__src a:hover {
    color: var(--ember);
  }

  /* ── terminal ── */
  .term {
    margin: var(--space-6) 0 0;
    max-width: 48rem;
    border: 2px solid var(--line-2);
    background: var(--ink-2);
    box-shadow: 4px 4px 0 var(--ink-3);
  }
  .term__bar {
    padding: var(--space-2) var(--space-4);
    border-bottom: 2px solid var(--line-2);
    color: var(--ash);
  }
  .term pre {
    margin: 0;
    padding: var(--space-4);
    overflow-x: auto;
    font-size: clamp(0.66rem, 0.6rem + 0.3vw, 0.82rem);
    line-height: 1.6;
    color: var(--ash);
  }
  .term pre code {
    font-size: inherit;
    color: inherit;
  }
  .term :global(.t-bone) {
    color: var(--bone);
  }
  .term :global(.t-dim) {
    color: var(--dust);
  }
  .term :global(.t-ember) {
    color: var(--ember);
  }
  .term__cap {
    padding: var(--space-2) var(--space-4) var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--dust);
    font-size: var(--step--1);
  }
</style>
