---
/**
 * § IV core.py: the podcast. A pixelated cover, the latest episode with a
 * pixel audio player, listen-on links, and the episode index.
 * Data lives in src/data/corepy.ts.
 */
import SectionHead from "./SectionHead.astro";
import { corepy, episodes } from "../data/corepy";

const INITIAL = 8;

const latest = episodes[0];
const shown = episodes.slice(0, INITIAL);
const rest = episodes.slice(INITIAL);

const totalSeconds = episodes.reduce((sum, e) => sum + e.seconds, 0);
const totalHours = Math.floor(totalSeconds / 3600);
const sinceYear = corepy.startDate.slice(0, 4);

/** 6143 -> "1:42:23", 2567 -> "42:47" */
function runtime(seconds: number): string {
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  const s = seconds % 60;
  const ss = String(s).padStart(2, "0");
  return h ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
}

/** Machine-readable ISO 8601 duration for <time datetime>. */
function isoDuration(seconds: number): string {
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  const s = seconds % 60;
  return `PT${h ? `${h}H` : ""}${m}M${s}S`;
}

function longDate(iso: string): string {
  return new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
}

const listen = [
  { label: "Apple Podcasts", href: corepy.links.apple },
  { label: "Spotify", href: corepy.links.spotify },
  { label: "YouTube", href: corepy.links.youtube },
  { label: "Pocket Casts", href: corepy.links.pocketCasts },
  { label: "RSS", href: corepy.links.rss },
];
---

<section id="corepy" class="corepy wrap" data-corepy>
  <SectionHead
    num="IV"
    title="core.py"
    kicker="podcast"
    lede="core.py is a podcast about CPython internals. Łukasz Langa and I host it. We talk about what changes in each release and why."
  >
    <p class="facts label">
      {episodes.length} episodes<span aria-hidden="true"> · </span><span
        class="visually-hidden">, </span
      >{totalHours} hours<span aria-hidden="true"> · </span><span
        class="visually-hidden">, </span
      >since {sinceYear}
    </p>
  </SectionHead>

  <div class="stage">
    <figure class="cover reveal">
      <img
        class="pixelated"
        src={corepy.coverPixel}
        alt="core.py cover art: three snakes knotted around the words CORE PY"
        width="112"
        height="112"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="main">
      <article class="ep reveal" aria-labelledby="corepy-latest">
        <p class="ep__meta label">
          <span><span class="ember">Latest</span> · No. {latest.number}</span>
          <span>
            <time datetime={latest.date}>{longDate(latest.date)}</time>
            <span aria-hidden="true"> · </span>
            <time datetime={isoDuration(latest.seconds)}>{runtime(latest.seconds)}</time>
          </span>
        </p>
        <h3 id="corepy-latest" class="ep__title">
          <span class="visually-hidden">Episode {latest.number}: </span>
          {latest.title}
        </h3>
        <p class="ep__summary">{latest.summary}</p>

        <div class="player" data-player>
          <audio
            class="player__native"
            controls
            hidden
            preload="none"
            src={latest.audio}
            data-audio
            data-num={latest.number}
            data-seconds={latest.seconds}
          >
            <a href={latest.url}>Listen to episode {latest.number}</a>
          </audio>
          <div class="player__ui" data-ui>
            <button
              class="pbtn"
              type="button"
              aria-label={`Play episode ${latest.number}`}
              data-toggle
            >
              <svg
                class="i-play"
                viewBox="0 0 5 7"
                shape-rendering="crispEdges"
                aria-hidden="true"
              >
                <path d="M0 0h2v7H0zM2 1h1v5H2zM3 2h1v3H3zM4 3h1v1H4z"></path>
              </svg>
              <svg
                class="i-pause"
                viewBox="0 0 5 7"
                shape-rendering="crispEdges"
                aria-hidden="true"
              >
                <path d="M0 0h2v7H0zM3 0h2v7H3z"></path>
              </svg>
            </button>
            <input
              class="seek"
              type="range"
              min="0"
              max={latest.seconds}
              step="1"
              value="0"
              aria-label="Seek"
              data-seek
            />
            <p class="player__time label">
              <span data-cur style={`min-width:${runtime(latest.seconds).length}ch`}>0:00</span> / <span data-dur
                >{runtime(latest.seconds)}</span
              >
            </p>
          </div>
          <p class="player__msg label" role="status" data-msg></p>
        </div>
        <!-- The pixel player is rendered visible, so the script does not
             change the layout on load. Without JS: the native controls. -->
        <noscript>
          <style is:inline>
            [data-corepy] [data-audio][hidden] { display: block !important; }
            [data-corepy] [data-ui] { display: none !important; }
          </style>
        </noscript>

        <p class="ep__links label">
          <a href={latest.url}>Episode page</a>
          {latest.youtube && <a href={latest.youtube}>Watch on YouTube</a>}
        </p>
      </article>

      <nav class="listen reveal" aria-label="Listen to core.py">
        <span class="label">Listen on</span>
        <ul role="list">
          {
            listen.map((l) => (
              <li>
                <a class="label" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="index reveal">
    <h3 class="label index__title">All episodes</h3>
    {
      [shown, rest].map((list, i) => {
        const rows = (
          <ol class="toc" role="list">
            {list.map((e) => (
              <li class:list={["row", { "is-latest": e === latest }]}>
                <span class="row__num label">
                  <span class="visually-hidden">Episode </span>
                  {e.number}
                </span>
                <a class="row__title" href={e.url}>
                  {e.title}
                </a>
                <span class="row__meta">
                  <time datetime={e.date}>{e.date}</time>
                  <time class="row__dur" datetime={isoDuration(e.seconds)}>
                    {runtime(e.seconds)}
                  </time>
                </span>
              </li>
            ))}
          </ol>
        );
        return i === 0 ? (
          rows
        ) : (
          <details class="more">
            <summary class="btn">
              <span class="more__closed">Show all {episodes.length}</span>
              <span class="more__open">Show fewer</span>
            </summary>
            {rows}
          </details>
        );
      })
    }
  </div>
</section>

<style>
  .corepy {
    padding-block: var(--space-8) var(--space-7);
  }

  .facts {
    color: var(--ash);
  }

  /* ─── stage: cover + latest episode ─── */
  .stage {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 52rem) {
    .stage {
      grid-template-columns: 224px minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }
  }

  .cover {
    margin: 0;
    width: 224px;
    border: 2px solid var(--line-2);
    box-shadow: 4px 4px 0 var(--ink-3);
    background: var(--ink);
  }
  .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .main {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  /* ─── latest episode box ─── */
  .ep {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4);
    border: 2px solid var(--line-2);
    background: var(--ink);
    box-shadow: 4px 4px 0 var(--ink-3);
  }
  @media (min-width: 40rem) {
    .ep {
      padding: var(--space-5) var(--space-5);
    }
  }
  .ep__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }
  .ep__title {
    font-family: var(--f-body);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.25;
  }
  .ep__summary {
    max-width: 40rem;
    color: var(--ash);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }
  .ep__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .ep__links a,
  .listen a {
    color: var(--ash);
    text-decoration: none;
  }
  .ep__links a:hover,
  .listen a:hover {
    color: var(--ember);
  }

  /* ─── player ─── */
  .player {
    padding-block: var(--space-2);
  }
  .player__native {
    width: 100%;
    height: 2.5rem;
    color-scheme: dark;
  }
  .player__ui:not([hidden]) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "btn seek"
      "btn time";
    align-items: center;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
  }
  @media (min-width: 40rem) {
    .player__ui:not([hidden]) {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: "btn seek time";
    }
  }
  .player__time {
    grid-area: time;
    color: var(--dust);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* reserve the width of the longest time, so playback never moves the bar */
  .player__time [data-cur] {
    display: inline-block;
    text-align: right;
  }
  .player.is-active [data-cur] {
    color: var(--bone);
  }
  .player__msg:empty {
    display: none;
  }
  .player__msg {
    margin-top: var(--space-3);
    color: var(--ember);
  }

  /* square pixel play / pause button */
  .pbtn {
    grid-area: btn;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2px solid var(--bone);
    border-radius: 0;
    background: var(--ink);
    color: var(--bone);
    box-shadow: 4px 4px 0 var(--ink-3);
    cursor: pointer;
  }
  .pbtn svg {
    width: 10px;
    height: 14px;
    fill: currentColor;
  }
  .pbtn .i-play {
    margin-left: 2px;
  }
  .pbtn .i-pause,
  .pbtn.is-playing .i-play {
    display: none;
  }
  .pbtn.is-playing .i-pause {
    display: block;
  }
  .pbtn:hover,
  .pbtn.is-playing {
    border-color: var(--ember);
    background: var(--ember);
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--ember-dim);
  }
  .pbtn:active {
    transform: translate(4px, 4px);
    box-shadow: none;
  }

  /*
   * Seek bar: a row of 6px blocks with 2px gaps. The script sets --p to a
   * whole number of blocks, so the fill moves one block at a time.
   */
  .seek {
    --p: 0px;
    --track: repeating-linear-gradient(
        90deg,
        transparent 0 6px,
        var(--ink) 6px 8px
      ),
      linear-gradient(90deg, var(--ember) var(--p), var(--line-2) var(--p));
    grid-area: seek;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 20px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  .seek::-webkit-slider-runnable-track {
    height: 10px;
    background: var(--track);
  }
  .seek::-moz-range-track {
    height: 10px;
    background: var(--track);
  }
  .seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 2px;
    height: 10px;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .seek::-moz-range-thumb {
    width: 2px;
    height: 10px;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .seek:hover {
    --track: repeating-linear-gradient(
        90deg,
        transparent 0 6px,
        var(--ink) 6px 8px
      ),
      linear-gradient(90deg, var(--ember) var(--p), var(--dust) var(--p));
  }

  /* ─── listen on ─── */
  .listen {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }
  .listen ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .listen a {
    color: var(--bone);
  }

  /* ─── the index ─── */
  .index {
    margin-top: var(--space-8);
  }
  .index__title {
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--line-2);
    color: var(--ash);
  }
  .toc {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    grid-template-areas:
      "num title"
      "num meta";
    column-gap: var(--space-3);
    row-gap: 0.15rem;
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .row__num {
    grid-area: num;
    font-variant-numeric: tabular-nums;
  }
  .is-latest .row__num {
    color: var(--ember);
  }
  .row__title {
    grid-area: title;
    line-height: 1.35;
    color: var(--bone);
    text-decoration: none;
  }
  .row__title:hover {
    color: var(--ember);
  }
  .row__meta {
    grid-area: meta;
    display: flex;
    gap: var(--space-4);
    font-size: var(--step--1);
    color: var(--dust);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      grid-template-areas: "num title meta";
      column-gap: var(--space-5);
    }
    .row__meta {
      gap: var(--space-5);
    }
    .row__dur {
      width: 7ch;
      text-align: right;
    }
  }

  /* show all, no JS needed */
  .more summary {
    margin-top: var(--space-5);
    list-style: none;
    cursor: pointer;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more__open,
  .more[open] .more__closed {
    display: none;
  }
  .more[open] .more__open {
    display: inline;
  }
  .more[open] summary {
    margin-bottom: var(--space-3);
  }
</style>

<script>
  const BLOCK = 8; // one seek block (6px) plus its gap (2px)

  function fmt(t: number): string {
    if (!Number.isFinite(t) || t < 0) t = 0;
    const s = Math.floor(t % 60);
    const m = Math.floor((t / 60) % 60);
    const h = Math.floor(t / 3600);
    const ss = String(s).padStart(2, "0");
    return h ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
  }

  function init(root: HTMLElement) {
    const audio = root.querySelector<HTMLAudioElement>("[data-audio]");
    const ui = root.querySelector<HTMLElement>("[data-ui]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]");
    const seek = root.querySelector<HTMLInputElement>("[data-seek]");
    const cur = root.querySelector<HTMLElement>("[data-cur]");
    const dur = root.querySelector<HTMLElement>("[data-dur]");
    const msg = root.querySelector<HTMLElement>("[data-msg]");
    const player = root.querySelector<HTMLElement>("[data-player]");
    if (!audio || !ui || !toggle || !seek || !cur || !dur || !msg || !player)
      return;

    // enhance: swap the native controls for the pixel ones
    audio.controls = false;
    audio.hidden = true;
    ui.hidden = false;

    const num = audio.dataset.num ?? "";
    const total = Number(audio.dataset.seconds) || 0;
    let dragging = false;

    const paint = () => {
      const d = Number.isFinite(audio.duration) ? audio.duration : total;
      if (!dragging) seek.value = String(Math.floor(audio.currentTime));
      const v = Number(seek.value);
      const blocks = d ? Math.floor(((v / d) * seek.clientWidth) / BLOCK) : 0;
      seek.style.setProperty("--p", `${blocks * BLOCK}px`);
      cur.textContent = fmt(v);
      seek.setAttribute("aria-valuetext", `${fmt(v)} of ${fmt(d)}`);
    };

    const sync = () => {
      const playing = !audio.paused && !audio.ended;
      player.classList.toggle("is-active", audio.currentTime > 0 || playing);
      toggle.classList.toggle("is-playing", playing);
      toggle.setAttribute(
        "aria-label",
        `${playing ? "Pause" : "Play"} episode ${num}`,
      );
    };

    toggle.addEventListener("click", () => {
      if (!audio.paused) return audio.pause();
      msg.textContent = "";
      audio.play().catch(() => {
        msg.textContent = "Could not load the audio. Use the episode page.";
      });
    });

    seek.addEventListener("input", () => {
      dragging = true;
      paint();
    });
    seek.addEventListener("change", () => {
      audio.currentTime = Number(seek.value);
      dragging = false;
      paint();
      sync();
    });

    audio.addEventListener("loadedmetadata", () => {
      if (Number.isFinite(audio.duration)) {
        seek.max = String(Math.floor(audio.duration));
        dur.textContent = fmt(audio.duration);
      }
    });
    audio.addEventListener("timeupdate", paint);
    for (const ev of ["play", "pause", "ended", "emptied"]) {
      audio.addEventListener(ev, sync);
    }
    audio.addEventListener("ended", () => {
      audio.currentTime = 0;
      paint();
    });
    new ResizeObserver(paint).observe(seek);

    paint();
    sync();
  }

  document
    .querySelectorAll<HTMLElement>("[data-corepy]")
    .forEach((el) => init(el));
</script>
