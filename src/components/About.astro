---
import { Image } from "astro:assets";
import portrait from "../assets/pablo-dither-160.png";
import SectionHead from "./SectionHead.astro";
import { traceback, bio, facts } from "../data/about";
---

<section id="about" class="wrap about">
  <SectionHead num="I" title="About" />

  <div class="grid">
    <figure class="plate reveal">
      <div class="plate__frame">
        <Image
          src={portrait}
          alt="Pixel portrait of Pablo wearing an ornate dark mask"
          width={160}
          height={160}
          format="png"
          loading="lazy"
        />
      </div>
    </figure>

    <div class="text">
      <pre class="tb reveal" aria-label="A Python traceback. Each frame is an event in my life. The line number is the year."><code><span class="tb__head">Traceback (most recent call last):</span>
{traceback.map((f) => (
  <span class="tb__frame">  File <span class="tb__file">"{f.file}"</span>, line <span class="tb__line">{f.line}</span>, in <span class="tb__fn">{f.fn}</span>
    {f.pre}<span class="tb__hl">{f.hl}</span>{f.post}
    {" ".repeat(f.pre.length)}<span class="ember">{"^".repeat(f.hl.length)}</span>
</span>
))}</code></pre>

      <div class="bio reveal">
        {bio.map((p) => <p set:html={p} />)}
      </div>

      <dl class="facts reveal">
        {
          facts.map((f) => (
            <div>
              <dt class="label">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: var(--space-8);
  }
  .grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(16rem, 5fr) 8fr;
      gap: var(--space-7);
      align-items: start;
    }
    .plate {
      position: sticky;
      top: 6rem;
    }
  }

  .plate {
    margin: 0;
    max-width: 26rem;
  }
  .plate__frame {
    border: 2px solid var(--line-2);
    box-shadow: 6px 6px 0 var(--ink-3);
  }
  .plate__frame :global(img) {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  .text {
    display: grid;
    gap: var(--space-6);
    min-width: 0;
  }

  .tb {
    margin: 0;
    padding: var(--space-5);
    overflow-x: auto;
    background: var(--ink-2);
    border: 2px solid var(--line-2);
    font-size: clamp(0.7rem, 0.62rem + 0.35vw, 0.86rem);
    line-height: 1.6;
    color: var(--ash);
  }
  .tb code {
    font-size: inherit;
  }
  .tb__head {
    color: var(--bone);
  }
  .tb__file {
    color: var(--bone);
  }
  .tb__fn {
    color: var(--gold);
  }
  .tb__hl {
    color: var(--bone);
  }
  .tb__err {
    color: var(--bone);
  }
  .tb__hint {
    color: var(--dust);
  }

  .bio {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }
  .bio :global(em) {
    color: var(--ash);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .facts div {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dd {
    margin: var(--space-1) 0 0;
  }
</style>
